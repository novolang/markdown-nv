    test.assert(commonmark("[link](/url 'title \"and\" title')\n")
                == "<p><a href=\"/url\" title=\"title &quot;and&quot; title\">link</a></p>\n")
    test.case("example 510")
    test.assert(commonmark("[link](   /uri\n  \"title\"  )\n")
                == "<p><a href=\"/uri\" title=\"title\">link</a></p>\n")
    test.case("example 511")
    test.assert(commonmark("[link] (/uri)\n")
                == "<p>[link] (/uri)</p>\n")

    test.assert(commonmark("[link [foo [bar]]](/uri)\n")
                == "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n")
    test.case("example 513")
    test.assert(commonmark("[link] bar](/uri)\n")
                == "<p>[link] bar](/uri)</p>\n")
    test.case("example 514")
    test.assert(commonmark("[link [bar](/uri)\n")
                == "<p>[link <a href=\"/uri\">bar</a></p>\n")
    test.case("example 515")
    test.assert(commonmark("[link \\[bar](/uri)\n")
                == "<p><a href=\"/uri\">link [bar</a></p>\n")
    test.case("example 516")
    test.assert(commonmark("[link *foo **bar** `#`*](/uri)\n")
                == "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n")
    test.case("example 517")
    test.assert(commonmark("[![moon](moon.jpg)](/uri)\n")
                == "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n")
    test.case("example 518")
    test.assert(commonmark("[foo [bar](/uri)](/uri)\n")
                == "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n")
    test.case("example 519")
    test.assert(commonmark("[foo *[bar [baz](/uri)](/uri)*](/uri)\n")
                == "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n")
    test.case("example 520")
    test.assert(commonmark("![[[foo](uri1)](uri2)](uri3)\n")
                == "<p><img src=\"uri3\" alt=\"[foo](uri2)\" /></p>\n")
    test.case("example 521")
    test.assert(commonmark("*[foo*](/uri)\n")
                == "<p>*<a href=\"/uri\">foo*</a></p>\n")
    test.case("example 522")
    test.assert(commonmark("[foo *bar](baz*)\n")
                == "<p><a href=\"baz*\">foo *bar</a></p>\n")
    test.case("example 523")
    test.assert(commonmark("*foo [bar* baz]\n")
                == "<p><em>foo [bar</em> baz]</p>\n")
    test.case("example 524")
    test.assert(commonmark("[foo <bar attr=\"](baz)\">\n")
                == "<p>[foo <bar attr=\"](baz)\"></p>\n")
    test.case("example 525")
    test.assert(commonmark("[foo`](/uri)`\n")
                == "<p>[foo<code>](/uri)</code></p>\n")
    test.case("example 526")
    test.assert(commonmark("[foo<https://example.com/?search=](uri)>\n")
                == "<p>[foo<a href=\"https://example.com/?search=%5D(uri)\">https://example.com/?search=](uri)</a></p>\n")
    test.case("example 527")
    test.assert(commonmark("[foo][bar]\n\n[bar]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n")
    test.case("example 528")
    test.assert(commonmark("[link [foo [bar]]][ref]\n\n[ref]: /uri\n")
                == "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n")
    test.case("example 529")
    test.assert(commonmark("[link \\[bar][ref]\n\n[ref]: /uri\n")
                == "<p><a href=\"/uri\">link [bar</a></p>\n")
    test.case("example 530")
    test.assert(commonmark("[link *foo **bar** `#`*][ref]\n\n[ref]: /uri\n")
                == "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n")
    test.case("example 531")
    test.assert(commonmark("[![moon](moon.jpg)][ref]\n\n[ref]: /uri\n")
                == "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n")
    test.case("example 532")
    test.assert(commonmark("[foo [bar](/uri)][ref]\n\n[ref]: /uri\n")
                == "<p>[foo <a href=\"/uri\">bar</a>]<a href=\"/uri\">ref</a></p>\n")
    test.case("example 533")
    test.assert(commonmark("[foo *bar [baz][ref]*][ref]\n\n[ref]: /uri\n")
                == "<p>[foo <em>bar <a href=\"/uri\">baz</a></em>]<a href=\"/uri\">ref</a></p>\n")
    test.case("example 534")
    test.assert(commonmark("*[foo*][ref]\n\n[ref]: /uri\n")
                == "<p>*<a href=\"/uri\">foo*</a></p>\n")
    test.case("example 535")
    test.assert(commonmark("[foo *bar][ref]*\n\n[ref]: /uri\n")
                == "<p><a href=\"/uri\">foo *bar</a>*</p>\n")
    test.case("example 536")
    test.assert(commonmark("[foo <bar attr=\"][ref]\">\n\n[ref]: /uri\n")
                == "<p>[foo <bar attr=\"][ref]\"></p>\n")
    test.case("example 537")
    test.assert(commonmark("[foo`][ref]`\n\n[ref]: /uri\n")
                == "<p>[foo<code>][ref]</code></p>\n")
    test.case("example 538")
    test.assert(commonmark("[foo<https://example.com/?search=][ref]>\n\n[ref]: /uri\n")
                == "<p>[foo<a href=\"https://example.com/?search=%5D%5Bref%5D\">https://example.com/?search=][ref]</a></p>\n")
    test.case("example 539")
    test.assert(commonmark("[foo][BaR]\n\n[bar]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n")
    test.case("example 540")
    test.assert(commonmark("[ẞ]\n\n[SS]: /url\n")
                == "<p><a href=\"/url\">ẞ</a></p>\n")
    test.case("example 541")
    test.assert(commonmark("[Foo\n  bar]: /url\n\n[Baz][Foo bar]\n")
                == "<p><a href=\"/url\">Baz</a></p>\n")
    test.case("example 542")
    test.assert(commonmark("[foo] [bar]\n\n[bar]: /url \"title\"\n")
                == "<p>[foo] <a href=\"/url\" title=\"title\">bar</a></p>\n")
    test.case("example 543")
    test.assert(commonmark("[foo]\n[bar]\n\n[bar]: /url \"title\"\n")
                == "<p>[foo]\n<a href=\"/url\" title=\"title\">bar</a></p>\n")
    test.case("example 544")
    test.assert(commonmark("[foo]: /url1\n\n[foo]: /url2\n\n[bar][foo]\n")
                == "<p><a href=\"/url1\">bar</a></p>\n")
    test.case("example 545")
    test.assert(commonmark("[bar][foo\\!]\n\n[foo!]: /url\n")
                == "<p>[bar][foo!]</p>\n")
    test.case("example 546")
    test.assert(commonmark("[foo][ref[]\n\n[ref[]: /uri\n")
                == "<p>[foo][ref[]</p>\n<p>[ref[]: /uri</p>\n")
    test.case("example 547")
    test.assert(commonmark("[foo][ref[bar]]\n\n[ref[bar]]: /uri\n")
                == "<p>[foo][ref[bar]]</p>\n<p>[ref[bar]]: /uri</p>\n")
    test.case("example 548")
    test.assert(commonmark("[[[foo]]]\n\n[[[foo]]]: /url\n")
                == "<p>[[[foo]]]</p>\n<p>[[[foo]]]: /url</p>\n")
    test.case("example 549")
    test.assert(commonmark("[foo][ref\\[]\n\n[ref\\[]: /uri\n")
                == "<p><a href=\"/uri\">foo</a></p>\n")
    test.case("example 550")
    test.assert(commonmark("[bar\\\\]: /uri\n\n[bar\\\\]\n")
                == "<p><a href=\"/uri\">bar\\</a></p>\n")
    test.case("example 551")
    test.assert(commonmark("[]\n\n[]: /uri\n")
                == "<p>[]</p>\n<p>[]: /uri</p>\n")
    test.case("example 552")
    test.assert(commonmark("[\n ]\n\n[\n ]: /uri\n")
                == "<p>[\n]</p>\n<p>[\n]: /uri</p>\n")
    test.case("example 553")
    test.assert(commonmark("[foo][]\n\n[foo]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n")
    test.case("example 554")
    test.assert(commonmark("[*foo* bar][]\n\n[*foo* bar]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>\n")
    test.case("example 555")
    test.assert(commonmark("[Foo][]\n\n[foo]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">Foo</a></p>\n")
    test.case("example 556")
    test.assert(commonmark("[foo] \n[]\n\n[foo]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a>\n[]</p>\n")
    test.case("example 557")
    test.assert(commonmark("[foo]\n\n[foo]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n")
    test.case("example 558")
    test.assert(commonmark("[*foo* bar]\n\n[*foo* bar]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>\n")
    test.case("example 559")
    test.assert(commonmark("[[*foo* bar]]\n\n[*foo* bar]: /url \"title\"\n")
                == "<p>[<a href=\"/url\" title=\"title\"><em>foo</em> bar</a>]</p>\n")
    test.case("example 560")
    test.assert(commonmark("[[bar [foo]\n\n[foo]: /url\n")
                == "<p>[[bar <a href=\"/url\">foo</a></p>\n")
    test.case("example 561")
    test.assert(commonmark("[Foo]\n\n[foo]: /url \"title\"\n")
                == "<p><a href=\"/url\" title=\"title\">Foo</a></p>\n")
    test.case("example 562")
    test.assert(commonmark("[foo] bar\n\n[foo]: /url\n")
                == "<p><a href=\"/url\">foo</a> bar</p>\n")
    test.case("example 563")
    test.assert(commonmark("\\[foo]\n\n[foo]: /url \"title\"\n")
                == "<p>[foo]</p>\n")
    test.case("example 564")
    test.assert(commonmark("[foo*]: /url\n\n*[foo*]\n")
                == "<p>*<a href=\"/url\">foo*</a></p>\n")
    test.case("example 565")
    test.assert(commonmark("[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n")
                == "<p><a href=\"/url2\">foo</a></p>\n")
    test.case("example 566")
    test.assert(commonmark("[foo][]\n\n[foo]: /url1\n")
                == "<p><a href=\"/url1\">foo</a></p>\n")
    test.case("example 567")
    test.assert(commonmark("[foo]()\n\n[foo]: /url1\n")
                == "<p><a href=\"\">foo</a></p>\n")
    test.case("example 568")
    test.assert(commonmark("[foo](not a link)\n\n[foo]: /url1\n")
                == "<p><a href=\"/url1\">foo</a>(not a link)</p>\n")
    test.case("example 569")
    test.assert(commonmark("[foo][bar][baz]\n\n[baz]: /url\n")
                == "<p>[foo]<a href=\"/url\">bar</a></p>\n")
    test.case("example 570")
    test.assert(commonmark("[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n")
                == "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>\n")
    test.case("example 571")
    test.assert(commonmark("[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n")
                == "<p>[foo]<a href=\"/url1\">bar</a></p>\n")

@test
fn test_images() [io]
    test.case("example 572")
    test.assert(commonmark("![foo](/url \"title\")\n")
                == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n")
    test.case("example 573")
    test.assert(commonmark("![foo *bar*]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n")
                == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n")
    test.case("example 574")
    test.assert(commonmark("![foo ![bar](/url)](/url2)\n")
                == "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n")
    test.case("example 575")
    test.assert(commonmark("![foo [bar](/url)](/url2)\n")
                == "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n")
    test.case("example 576")
    test.assert(commonmark("![foo *bar*][]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n")
                == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n")
    test.case("example 577")
    test.assert(commonmark("![foo *bar*][foobar]\n\n[FOOBAR]: train.jpg \"train & tracks\"\n")
                == "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n")
    test.case("example 578")
    test.assert(commonmark("![foo](train.jpg)\n")
                == "<p><img src=\"train.jpg\" alt=\"foo\" /></p>\n")
    test.case("example 579")
    test.assert(commonmark("My ![foo bar](/path/to/train.jpg  \"title\"   )\n")
                == "<p>My <img src=\"/path/to/train.jpg\" alt=\"foo bar\" title=\"title\" /></p>\n")
    test.case("example 580")
    test.assert(commonmark("![foo](<url>)\n")
                == "<p><img src=\"url\" alt=\"foo\" /></p>\n")
    test.case("example 581")
    test.assert(commonmark("![](/url)\n")
                == "<p><img src=\"/url\" alt=\"\" /></p>\n")
    test.case("example 582")
    test.assert(commonmark("![foo][bar]\n\n[bar]: /url\n")
                == "<p><img src=\"/url\" alt=\"foo\" /></p>\n")
    test.case("example 583")
    test.assert(commonmark("![foo][bar]\n\n[BAR]: /url\n")
                == "<p><img src=\"/url\" alt=\"foo\" /></p>\n")
    test.case("example 584")
    test.assert(commonmark("![foo][]\n\n[foo]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n")
    test.case("example 585")
    test.assert(commonmark("![*foo* bar][]\n\n[*foo* bar]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>\n")
    test.case("example 586")
    test.assert(commonmark("![Foo][]\n\n[foo]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>\n")
    test.case("example 587")
    test.assert(commonmark("![foo] \n[]\n\n[foo]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" />\n[]</p>\n")
    test.case("example 588")
    test.assert(commonmark("![foo]\n\n[foo]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n")
    test.case("example 589")
    test.assert(commonmark("![*foo* bar]\n\n[*foo* bar]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"foo bar\" title=\"title\" /></p>\n")
    test.case("example 590")
    test.assert(commonmark("![[foo]]\n\n[[foo]]: /url \"title\"\n")
                == "<p>![[foo]]</p>\n<p>[[foo]]: /url &quot;title&quot;</p>\n")
    test.case("example 591")
    test.assert(commonmark("![Foo]\n\n[foo]: /url \"title\"\n")
                == "<p><img src=\"/url\" alt=\"Foo\" title=\"title\" /></p>\n")
    test.case("example 592")
    test.assert(commonmark("!\\[foo]\n\n[foo]: /url \"title\"\n")
                == "<p>![foo]</p>\n")
    test.case("example 593")
    test.assert(commonmark("\\![foo]\n\n[foo]: /url \"title\"\n")
                == "<p>!<a href=\"/url\" title=\"title\">foo</a></p>\n")

@test
fn test_autolinks() [io]
    test.case("example 594")
    test.assert(commonmark("<http://foo.bar.baz>\n")
                == "<p><a href=\"http://foo.bar.baz\">http://foo.bar.baz</a></p>\n")
    test.case("example 595")
    test.assert(commonmark("<https://foo.bar.baz/test?q=hello&id=22&boolean>\n")
                == "<p><a href=\"https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean\">https://foo.bar.baz/test?q=hello&amp;id=22&amp;boolean</a></p>\n")
    test.case("example 596")
    test.assert(commonmark("<irc://foo.bar:2233/baz>\n")
                == "<p><a href=\"irc://foo.bar:2233/baz\">irc://foo.bar:2233/baz</a></p>\n")
    test.case("example 597")
    test.assert(commonmark("<MAILTO:FOO@BAR.BAZ>\n")
                == "<p><a href=\"MAILTO:FOO@BAR.BAZ\">MAILTO:FOO@BAR.BAZ</a></p>\n")
    test.case("example 598")
    test.assert(commonmark("<a+b+c:d>\n")
                == "<p><a href=\"a+b+c:d\">a+b+c:d</a></p>\n")
    test.case("example 599")
    test.assert(commonmark("<made-up-scheme://foo,bar>\n")
                == "<p><a href=\"made-up-scheme://foo,bar\">made-up-scheme://foo,bar</a></p>\n")
    test.case("example 600")
    test.assert(commonmark("<https://../>\n")
                == "<p><a href=\"https://../\">https://../</a></p>\n")
    test.case("example 601")
    test.assert(commonmark("<localhost:5001/foo>\n")
                == "<p><a href=\"localhost:5001/foo\">localhost:5001/foo</a></p>\n")
    test.case("example 602")
    test.assert(commonmark("<https://foo.bar/baz bim>\n")
                == "<p>&lt;https://foo.bar/baz bim&gt;</p>\n")
    test.case("example 603")
    test.assert(commonmark("<https://example.com/\\[\\>\n")
                == "<p><a href=\"https://example.com/%5C%5B%5C\">https://example.com/\\[\\</a></p>\n")
    test.case("example 604")
    test.assert(commonmark("<foo@bar.example.com>\n")
                == "<p><a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a></p>\n")
    test.case("example 605")
    test.assert(commonmark("<foo+special@Bar.baz-bar0.com>\n")
                == "<p><a href=\"mailto:foo+special@Bar.baz-bar0.com\">foo+special@Bar.baz-bar0.com</a></p>\n")
    test.case("example 606")
    test.assert(commonmark("<foo\\+@bar.example.com>\n")
                == "<p>&lt;foo+@bar.example.com&gt;</p>\n")
    test.case("example 607")
    test.assert(commonmark("<>\n")
                == "<p>&lt;&gt;</p>\n")
    test.case("example 608")
    test.assert(commonmark("< https://foo.bar >\n")
                == "<p>&lt; https://foo.bar &gt;</p>\n")
    test.case("example 609")
    test.assert(commonmark("<m:abc>\n")
                == "<p>&lt;m:abc&gt;</p>\n")
    test.case("example 610")
    test.assert(commonmark("<foo.bar.baz>\n")
                == "<p>&lt;foo.bar.baz&gt;</p>\n")
    test.case("example 611")
    test.assert(commonmark("https://example.com\n")
                == "<p>https://example.com</p>\n")
    test.case("example 612")
    test.assert(commonmark("foo@bar.example.com\n")
                == "<p>foo@bar.example.com</p>\n")

@test
fn test_raw_html() [io]
    test.case("example 613")
    test.assert(commonmark("<a><bab><c2c>\n")
                == "<p><a><bab><c2c></p>\n")
    test.case("example 614")
    test.assert(commonmark("<a/><b2/>\n")
                == "<p><a/><b2/></p>\n")
    test.case("example 615")
    test.assert(commonmark("<a  /><b2\ndata=\"foo\" >\n")
                == "<p><a  /><b2\ndata=\"foo\" ></p>\n")
    test.case("example 616")
    test.assert(commonmark("<a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 />\n")
                == "<p><a foo=\"bar\" bam = 'baz <em>\"</em>'\n_boolean zoop:33=zoop:33 /></p>\n")
    test.case("example 617")
    test.assert(commonmark("Foo <responsive-image src=\"foo.jpg\" />\n")
                == "<p>Foo <responsive-image src=\"foo.jpg\" /></p>\n")
    test.case("example 618")
    test.assert(commonmark("<33> <__>\n")
                == "<p>&lt;33&gt; &lt;__&gt;</p>\n")
    test.case("example 619")
    test.assert(commonmark("<a h*#ref=\"hi\">\n")
                == "<p>&lt;a h*#ref=&quot;hi&quot;&gt;</p>\n")
    test.case("example 620")
    test.assert(commonmark("<a href=\"hi'> <a href=hi'>\n")
                == "<p>&lt;a href=&quot;hi'&gt; &lt;a href=hi'&gt;</p>\n")
    test.case("example 621")
    test.assert(commonmark("< a><\nfoo><bar/ >\n<foo bar=baz\nbim!bop />\n")
                == "<p>&lt; a&gt;&lt;\nfoo&gt;&lt;bar/ &gt;\n&lt;foo bar=baz\nbim!bop /&gt;</p>\n")
    test.case("example 622")
    test.assert(commonmark("<a href='bar'title=title>\n")
                == "<p>&lt;a href='bar'title=title&gt;</p>\n")
    test.case("example 623")
    test.assert(commonmark("</a></foo >\n")
                == "<p></a></foo ></p>\n")
    test.case("example 624")
    test.assert(commonmark("</a href=\"foo\">\n")
                == "<p>&lt;/a href=&quot;foo&quot;&gt;</p>\n")
    test.case("example 625")
    test.assert(commonmark("foo <!-- this is a --\ncomment - with hyphens -->\n")
                == "<p>foo <!-- this is a --\ncomment - with hyphens --></p>\n")
    test.case("example 626")
    test.assert(commonmark("foo <!--> foo -->\n\nfoo <!---> foo -->\n")
                == "<p>foo <!--> foo --&gt;</p>\n<p>foo <!---> foo --&gt;</p>\n")
    test.case("example 627")
    test.assert(commonmark("foo <?php echo \$a; ?>\n")
                == "<p>foo <?php echo \$a; ?></p>\n")
    test.case("example 628")
    test.assert(commonmark("foo <!ELEMENT br EMPTY>\n")
                == "<p>foo <!ELEMENT br EMPTY></p>\n")
    test.case("example 629")
    test.assert(commonmark("foo <![CDATA[>&<]]>\n")
                == "<p>foo <![CDATA[>&<]]></p>\n")
    test.case("example 630")
    test.assert(commonmark("foo <a href=\"&ouml;\">\n")
                == "<p>foo <a href=\"&ouml;\"></p>\n")
    test.case("example 631")
    test.assert(commonmark("foo <a href=\"\\*\">\n")
                == "<p>foo <a href=\"\\*\"></p>\n")
    test.case("example 632")
    test.assert(commonmark("<a href=\"\\\"\">\n")
                == "<p>&lt;a href=&quot;&quot;&quot;&gt;</p>\n")

@test
fn test_hard_line_breaks() [io]
    test.case("example 633")
    test.assert(commonmark("foo  \nbaz\n")
                == "<p>foo<br />\nbaz</p>\n")
    test.case("example 634")
    test.assert(commonmark("foo\\\nbaz\n")
                == "<p>foo<br />\nbaz</p>\n")
    test.case("example 635")
    test.assert(commonmark("foo       \nbaz\n")
                == "<p>foo<br />\nbaz</p>\n")
    test.case("example 636")
    test.assert(commonmark("foo  \n     bar\n")
                == "<p>foo<br />\nbar</p>\n")
    test.case("example 637")
    test.assert(commonmark("foo\\\n     bar\n")
                == "<p>foo<br />\nbar</p>\n")
    test.case("example 638")
    test.assert(commonmark("*foo  \nbar*\n")
                == "<p><em>foo<br />\nbar</em></p>\n")
    test.case("example 639")
    test.assert(commonmark("*foo\\\nbar*\n")
                == "<p><em>foo<br />\nbar</em></p>\n")
    test.case("example 640")
    test.assert(commonmark("`code  \nspan`\n")
                == "<p><code>code   span</code></p>\n")
    test.case("example 641")
    test.assert(commonmark("`code\\\nspan`\n")
                == "<p><code>code\\ span</code></p>\n")
    test.case("example 642")
    test.assert(commonmark("<a href=\"foo  \nbar\">\n")
                == "<p><a href=\"foo  \nbar\"></p>\n")
    test.case("example 643")
    test.assert(commonmark("<a href=\"foo\\\nbar\">\n")
                == "<p><a href=\"foo\\\nbar\"></p>\n")
    test.case("example 644")
    test.assert(commonmark("foo\\\n")
                == "<p>foo\\</p>\n")
    test.case("example 645")
    test.assert(commonmark("foo  \n")
                == "<p>foo</p>\n")
    test.case("example 646")
    test.assert(commonmark("### foo\\\n")
                == "<h3>foo\\</h3>\n")
    test.case("example 647")
    test.assert(commonmark("### foo  \n")
                == "<h3>foo</h3>\n")

@test
fn test_soft_line_breaks() [io]
    test.case("example 648")
    test.assert(commonmark("foo\nbaz\n")
                == "<p>foo\nbaz</p>\n")
    test.case("example 649")
    test.assert(commonmark("foo \n baz\n")
                == "<p>foo\nbaz</p>\n")

@test
fn test_textual_content() [io]
    test.case("example 650")
    test.assert(commonmark("hello \$.;'there\n")
                == "<p>hello \$.;'there</p>\n")
    test.case("example 651")
    test.assert(commonmark("Foo χρῆν\n")
                == "<p>Foo χρῆν</p>\n")
    test.case("example 652")
    test.assert(commonmark("Multiple     spaces\n")
                == "<p>Multiple     spaces</p>\n")

@test
fn test_gfm_table() [io]
    test.case("GFM table example 1")
    test.assert(gfm("| foo | bar |\n| --- | --- |\n| baz | bim |\n") == "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>\n")
    test.case("GFM table example 2")
    test.assert(gfm("| abc | defghi |\n:-: | -----------:\nbar | baz\n") == "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>\n")
    test.case("GFM table example 3")
    test.assert(gfm("| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n") == "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>\n")
    test.case("GFM table example 4")
    test.assert(gfm("| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    test.case("GFM table example 5")
    test.assert(gfm("| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>\n")
    test.case("GFM table example 6")
    test.assert(gfm("| abc | def |\n| --- |\n| bar |\n") == "<p>| abc | def |\n| --- |\n| bar |</p>\n")
    test.case("GFM table example 7")
    test.assert(gfm("| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n")
    test.case("GFM table example 8")
    test.assert(gfm("| abc | def |\n| --- | --- |\n") == "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>\n")

@test
fn test_gfm_strikethrough() [io]
    test.case("GFM strikethrough example 1")
    test.assert(gfm("~~Hi~~ Hello, world!\n") == "<p><del>Hi</del> Hello, world!</p>\n")
    test.case("GFM strikethrough example 2")
    test.assert(gfm("This ~~has a\n\nnew paragraph~~.\n") == "<p>This ~~has a</p>\n<p>new paragraph~~.</p>\n")

@test
fn test_gfm_autolink() [io]
    test.case("GFM autolink example 1")
    test.assert(gfm("www.commonmark.org\n") == "<p><a href=\"http://www.commonmark.org\">www.commonmark.org</a></p>\n")
    test.case("GFM autolink example 2")
    test.assert(gfm("Visit www.commonmark.org/help for more information.\n") == "<p>Visit <a href=\"http://www.commonmark.org/help\">www.commonmark.org/help</a> for more information.</p>\n")
    test.case("GFM autolink example 3")
    test.assert(gfm("Visit www.commonmark.org.\n\nVisit www.commonmark.org/a.b.\n") == "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>Visit <a href=\"http://www.commonmark.org/a.b\">www.commonmark.org/a.b</a>.</p>\n")
    test.case("GFM autolink example 4")
    test.assert(gfm("www.google.com/search?q=Markup+(business)\n\nwww.google.com/search?q=Markup+(business)))\n\n(www.google.com/search?q=Markup+(business))\n\n(www.google.com/search?q=Markup+(business)\n") == "<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n<p><a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>))</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a>)</p>\n<p>(<a href=\"http://www.google.com/search?q=Markup+(business)\">www.google.com/search?q=Markup+(business)</a></p>\n")
    test.case("GFM autolink example 5")
    test.assert(gfm("www.google.com/search?q=(business))+ok\n") == "<p><a href=\"http://www.google.com/search?q=(business))+ok\">www.google.com/search?q=(business))+ok</a></p>\n")
    test.case("GFM autolink example 6")
    test.assert(gfm("www.google.com/search?q=commonmark&hl=en\n\nwww.google.com/search?q=commonmark&hl;\n") == "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en\">www.google.com/search?q=commonmark&amp;hl=en</a></p>\n<p><a href=\"http://www.google.com/search?q=commonmark\">www.google.com/search?q=commonmark</a>&amp;hl;</p>\n")
    test.case("GFM autolink example 7")
    test.assert(gfm("www.commonmark.org/he<lp\n") == "<p><a href=\"http://www.commonmark.org/he\">www.commonmark.org/he</a>&lt;lp</p>\n")
    test.case("GFM autolink example 8")
    test.assert(gfm("http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n\nAnonymous FTP is available at ftp://foo.bar.baz.\n") == "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=Markup+(business)\">https://encrypted.google.com/search?q=Markup+(business)</a>)</p>\n<p>Anonymous FTP is available at <a href=\"ftp://foo.bar.baz\">ftp://foo.bar.baz</a>.</p>\n")
    test.case("GFM autolink example 9")
    test.assert(gfm("foo@bar.baz\n") == "<p><a href=\"mailto:foo@bar.baz\">foo@bar.baz</a></p>\n")
    test.case("GFM autolink example 10")
    test.assert(gfm("hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n") == "<p>hello@mail+xyz.example isn't valid, but <a href=\"mailto:hello+xyz@mail.example\">hello+xyz@mail.example</a> is.</p>\n")
    test.case("GFM autolink example 11")
    test.assert(gfm("a.b-c_d@a.b\n\na.b-c_d@a.b.\n\na.b-c_d@a.b-\n\na.b-c_d@a.b_\n") == "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a></p>\n<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n<p>a.b-c_d@a.b-</p>\n<p>a.b-c_d@a.b_</p>\n")

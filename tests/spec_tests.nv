@test
fn test_links() [io]
    test.case("example 482")
    test.assert(commonmark("[link](/uri \"title\")\n")
                == "<p><a href=\"/uri\" title=\"title\">link</a></p>\n")
    test.case("example 483")
    test.assert(commonmark("[link](/uri)\n")
                == "<p><a href=\"/uri\">link</a></p>\n")
    test.case("example 484")
    test.assert(commonmark("[](./target.md)\n")
                == "<p><a href=\"./target.md\"></a></p>\n")
    test.case("example 485")
    test.assert(commonmark("[link]()\n")
                == "<p><a href=\"\">link</a></p>\n")
    test.case("example 486")
    test.assert(commonmark("[link](<>)\n")
                == "<p><a href=\"\">link</a></p>\n")
    test.case("example 487")
    test.assert(commonmark("[]()\n")
                == "<p><a href=\"\"></a></p>\n")
    test.case("example 488")
    test.assert(commonmark("[link](/my uri)\n")
                == "<p>[link](/my uri)</p>\n")
    test.case("example 489")
    test.assert(commonmark("[link](</my uri>)\n")
                == "<p><a href=\"/my%20uri\">link</a></p>\n")
    test.case("example 490")
    test.assert(commonmark("[link](foo\nbar)\n")
                == "<p>[link](foo\nbar)</p>\n")
    test.case("example 491")
    test.assert(commonmark("[link](<foo\nbar>)\n")
                == "<p>[link](<foo\nbar>)</p>\n")
    test.case("example 492")
    test.assert(commonmark("[a](<b)c>)\n")
                == "<p><a href=\"b)c\">a</a></p>\n")
    test.case("example 493")
    test.assert(commonmark("[link](<foo\\>)\n")
                == "<p>[link](&lt;foo&gt;)</p>\n")
    test.case("example 494")
    test.assert(commonmark("[a](<b)c\n[a](<b)c>\n[a](<b>c)\n")
                == "<p>[a](&lt;b)c\n[a](&lt;b)c&gt;\n[a](<b>c)</p>\n")
    test.case("example 495")
    test.assert(commonmark("[link](\\(foo\\))\n")
                == "<p><a href=\"(foo)\">link</a></p>\n")
    test.case("example 496")
    test.assert(commonmark("[link](foo(and(bar)))\n")
                == "<p><a href=\"foo(and(bar))\">link</a></p>\n")
    test.case("example 497")
    test.assert(commonmark("[link](foo(and(bar))\n")
                == "<p>[link](foo(and(bar))</p>\n")
    test.case("example 498")
    test.assert(commonmark("[link](foo\\(and\\(bar\\))\n")
                == "<p><a href=\"foo(and(bar)\">link</a></p>\n")
    test.case("example 499")
    test.assert(commonmark("[link](<foo(and(bar)>)\n")
                == "<p><a href=\"foo(and(bar)\">link</a></p>\n")
    test.case("example 500")
    test.assert(commonmark("[link](foo\\)\\:)\n")
                == "<p><a href=\"foo):\">link</a></p>\n")
    test.case("example 501")
    test.assert(commonmark("[link](#fragment)\n\n[link](https://example.com#fragment)\n\n[link](https://example.com?foo=3#frag)\n")
                == "<p><a href=\"#fragment\">link</a></p>\n<p><a href=\"https://example.com#fragment\">link</a></p>\n<p><a href=\"https://example.com?foo=3#frag\">link</a></p>\n")
    test.case("example 502")
    test.assert(commonmark("[link](foo\\bar)\n")
                == "<p><a href=\"foo%5Cbar\">link</a></p>\n")
    test.case("example 503")
    test.assert(commonmark("[link](foo%20b&auml;)\n")
                == "<p><a href=\"foo%20b%C3%A4\">link</a></p>\n")
    test.case("example 504")
    test.assert(commonmark("[link](\"title\")\n")
                == "<p><a href=\"%22title%22\">link</a></p>\n")
    test.case("example 505")
    test.assert(commonmark("[link](/url \"title\")\n[link](/url 'title')\n[link](/url (title))\n")
                == "<p><a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a></p>\n")
    test.case("example 506")
    test.assert(commonmark("[link](/url \"title \\\"&quot;\")\n")
                == "<p><a href=\"/url\" title=\"title &quot;&quot;\">link</a></p>\n")
    test.case("example 507")
    test.assert(commonmark("[link](/url \"title\")\n")
                == "<p><a href=\"/url%C2%A0%22title%22\">link</a></p>\n")

// spec_tests.nv — every example of the CommonMark specification, and
// the GFM specification's table, strikethrough and autolink examples.
//
// Written by tools/spec_tests.py from CommonMark 0.31.2 (652 examples)
// and cmark-gfm's test/spec.txt (21 examples); do not edit by hand.
// Each example is Markdown and the HTML the specification says it
// renders to, compared byte for byte.

use std.test
use mdparse
use mdhtml

fn commonmark(md: Str) -> Str
    mdhtml.render_str(md, mdhtml.commonmark_options())

fn gfm(md: Str) -> Str
    var o = mdhtml.commonmark_options()
    o.markdown = mdparse.gfm_options()
    mdhtml.render_str(md, o)

@test
fn test_tabs() [io]
    test.case("example 1")
    test.assert(commonmark("\tfoo\tbaz\t\tbim\n")
                == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n")
    test.case("example 2")
    test.assert(commonmark("  \tfoo\tbaz\t\tbim\n")
                == "<pre><code>foo\tbaz\t\tbim\n</code></pre>\n")
    test.case("example 3")
    test.assert(commonmark("    a\ta\n    ὐ\ta\n")
                == "<pre><code>a\ta\nὐ\ta\n</code></pre>\n")
    test.case("example 4")
    test.assert(commonmark("  - foo\n\n\tbar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")
    test.case("example 5")
    test.assert(commonmark("- foo\n\n\t\tbar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<pre><code>  bar\n</code></pre>\n</li>\n</ul>\n")
    test.case("example 6")
    test.assert(commonmark(">\t\tfoo\n")
                == "<blockquote>\n<pre><code>  foo\n</code></pre>\n</blockquote>\n")
    test.case("example 7")
    test.assert(commonmark("-\t\tfoo\n")
                == "<ul>\n<li>\n<pre><code>  foo\n</code></pre>\n</li>\n</ul>\n")
    test.case("example 8")
    test.assert(commonmark("    foo\n\tbar\n")
                == "<pre><code>foo\nbar\n</code></pre>\n")
    test.case("example 9")
    test.assert(commonmark(" - foo\n   - bar\n\t - baz\n")
                == "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n")
    test.case("example 10")
    test.assert(commonmark("#\tFoo\n")
                == "<h1>Foo</h1>\n")
    test.case("example 11")
    test.assert(commonmark("*\t*\t*\t\n")
                == "<hr />\n")

@test
fn test_backslash_escapes() [io]
    test.case("example 12")
    test.assert(commonmark("\\!\\\"\\#\\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n")
                == "<p>!&quot;#\$%&amp;'()*+,-./:;&lt;=&gt;?@[\\]^_`{|}~</p>\n")
    test.case("example 13")
    test.assert(commonmark("\\\t\\A\\a\\ \\3\\φ\\«\n")
                == "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>\n")
    test.case("example 14")
    test.assert(commonmark("\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity\n")
                == "<p>*not emphasized*\n&lt;br/&gt; not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url &quot;not a reference&quot;\n&amp;ouml; not a character entity</p>\n")
    test.case("example 15")
    test.assert(commonmark("\\\\*emphasis*\n")
                == "<p>\\<em>emphasis</em></p>\n")
    test.case("example 16")
    test.assert(commonmark("foo\\\nbar\n")
                == "<p>foo<br />\nbar</p>\n")
    test.case("example 17")
    test.assert(commonmark("`` \\[\\` ``\n")
                == "<p><code>\\[\\`</code></p>\n")
    test.case("example 18")
    test.assert(commonmark("    \\[\\]\n")
                == "<pre><code>\\[\\]\n</code></pre>\n")
    test.case("example 19")
    test.assert(commonmark("~~~\n\\[\\]\n~~~\n")
                == "<pre><code>\\[\\]\n</code></pre>\n")
    test.case("example 20")
    test.assert(commonmark("<https://example.com?find=\\*>\n")
                == "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>\n")
    test.case("example 21")
    test.assert(commonmark("<a href=\"/bar\\/)\">\n")
                == "<a href=\"/bar\\/)\">\n")
    test.case("example 22")
    test.assert(commonmark("[foo](/bar\\* \"ti\\*tle\")\n")
                == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n")
    test.case("example 23")
    test.assert(commonmark("[foo]\n\n[foo]: /bar\\* \"ti\\*tle\"\n")
                == "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n")
    test.case("example 24")
    test.assert(commonmark("``` foo\\+bar\nfoo\n```\n")
                == "<pre><code class=\"language-foo+bar\">foo\n</code></pre>\n")

@test
fn test_entity_and_numeric_character_references() [io]
    test.case("example 25")
    test.assert(commonmark("&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n")
                == "<p>  &amp; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>\n")
    test.case("example 26")
    test.assert(commonmark("&#35; &#1234; &#992; &#0;\n")
                == "<p># Ӓ Ϡ �</p>\n")
    test.case("example 27")
    test.assert(commonmark("&#X22; &#XD06; &#xcab;\n")
                == "<p>&quot; ആ ಫ</p>\n")
    test.case("example 28")
    test.assert(commonmark("&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?;\n")
                == "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#abcdef0;\n&amp;ThisIsNotDefined; &amp;hi?;</p>\n")
    test.case("example 29")
    test.assert(commonmark("&copy\n")
                == "<p>&amp;copy</p>\n")
    test.case("example 30")
    test.assert(commonmark("&MadeUpEntity;\n")
                == "<p>&amp;MadeUpEntity;</p>\n")
    test.case("example 31")
    test.assert(commonmark("<a href=\"&ouml;&ouml;.html\">\n")
                == "<a href=\"&ouml;&ouml;.html\">\n")
    test.case("example 32")
    test.assert(commonmark("[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\")\n")
                == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n")
    test.case("example 33")
    test.assert(commonmark("[foo]\n\n[foo]: /f&ouml;&ouml; \"f&ouml;&ouml;\"\n")
                == "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>\n")
    test.case("example 34")
    test.assert(commonmark("``` f&ouml;&ouml;\nfoo\n```\n")
                == "<pre><code class=\"language-föö\">foo\n</code></pre>\n")
    test.case("example 35")
    test.assert(commonmark("`f&ouml;&ouml;`\n")
                == "<p><code>f&amp;ouml;&amp;ouml;</code></p>\n")
    test.case("example 36")
    test.assert(commonmark("    f&ouml;f&ouml;\n")
                == "<pre><code>f&amp;ouml;f&amp;ouml;\n</code></pre>\n")
    test.case("example 37")
    test.assert(commonmark("&#42;foo&#42;\n*foo*\n")
                == "<p>*foo*\n<em>foo</em></p>\n")
    test.case("example 38")
    test.assert(commonmark("&#42; foo\n\n* foo\n")
                == "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>\n")
    test.case("example 39")
    test.assert(commonmark("foo&#10;&#10;bar\n")
                == "<p>foo\n\nbar</p>\n")
    test.case("example 40")
    test.assert(commonmark("&#9;foo\n")
                == "<p>\tfoo</p>\n")
    test.case("example 41")
    test.assert(commonmark("[a](url &quot;tit&quot;)\n")
                == "<p>[a](url &quot;tit&quot;)</p>\n")

@test
fn test_precedence() [io]
    test.case("example 42")
    test.assert(commonmark("- `one\n- two`\n")
                == "<ul>\n<li>`one</li>\n<li>two`</li>\n</ul>\n")

@test
fn test_thematic_breaks() [io]
    test.case("example 43")
    test.assert(commonmark("***\n---\n___\n")
                == "<hr />\n<hr />\n<hr />\n")
    test.case("example 44")
    test.assert(commonmark("+++\n")
                == "<p>+++</p>\n")
    test.case("example 45")
    test.assert(commonmark("===\n")
                == "<p>===</p>\n")
    test.case("example 46")
    test.assert(commonmark("--\n**\n__\n")
                == "<p>--\n**\n__</p>\n")
    test.case("example 47")
    test.assert(commonmark(" ***\n  ***\n   ***\n")
                == "<hr />\n<hr />\n<hr />\n")
    test.case("example 48")
    test.assert(commonmark("    ***\n")
                == "<pre><code>***\n</code></pre>\n")
    test.case("example 49")
    test.assert(commonmark("Foo\n    ***\n")
                == "<p>Foo\n***</p>\n")
    test.case("example 50")
    test.assert(commonmark("_____________________________________\n")
                == "<hr />\n")
    test.case("example 51")
    test.assert(commonmark(" - - -\n")
                == "<hr />\n")
    test.case("example 52")
    test.assert(commonmark(" **  * ** * ** * **\n")
                == "<hr />\n")
    test.case("example 53")
    test.assert(commonmark("-     -      -      -\n")
                == "<hr />\n")
    test.case("example 54")
    test.assert(commonmark("- - - -    \n")
                == "<hr />\n")
    test.case("example 55")
    test.assert(commonmark("_ _ _ _ a\n\na------\n\n---a---\n")
                == "<p>_ _ _ _ a</p>\n<p>a------</p>\n<p>---a---</p>\n")
    test.case("example 56")
    test.assert(commonmark(" *-*\n")
                == "<p><em>-</em></p>\n")
    test.case("example 57")
    test.assert(commonmark("- foo\n***\n- bar\n")
                == "<ul>\n<li>foo</li>\n</ul>\n<hr />\n<ul>\n<li>bar</li>\n</ul>\n")
    test.case("example 58")
    test.assert(commonmark("Foo\n***\nbar\n")
                == "<p>Foo</p>\n<hr />\n<p>bar</p>\n")
    test.case("example 59")
    test.assert(commonmark("Foo\n---\nbar\n")
                == "<h2>Foo</h2>\n<p>bar</p>\n")
    test.case("example 60")
    test.assert(commonmark("* Foo\n* * *\n* Bar\n")
                == "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n<ul>\n<li>Bar</li>\n</ul>\n")
    test.case("example 61")
    test.assert(commonmark("- Foo\n- * * *\n")
                == "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n")

@test
fn test_atx_headings() [io]
    test.case("example 62")
    test.assert(commonmark("# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n")
                == "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n")
    test.case("example 63")
    test.assert(commonmark("####### foo\n")
                == "<p>####### foo</p>\n")
    test.case("example 64")
    test.assert(commonmark("#5 bolt\n\n#hashtag\n")
                == "<p>#5 bolt</p>\n<p>#hashtag</p>\n")
    test.case("example 65")
    test.assert(commonmark("\\## foo\n")
                == "<p>## foo</p>\n")
    test.case("example 66")
    test.assert(commonmark("# foo *bar* \\*baz\\*\n")
                == "<h1>foo <em>bar</em> *baz*</h1>\n")
    test.case("example 67")
    test.assert(commonmark("#                  foo                     \n")
                == "<h1>foo</h1>\n")
    test.case("example 68")
    test.assert(commonmark(" ### foo\n  ## foo\n   # foo\n")
                == "<h3>foo</h3>\n<h2>foo</h2>\n<h1>foo</h1>\n")
    test.case("example 69")
    test.assert(commonmark("    # foo\n")
                == "<pre><code># foo\n</code></pre>\n")
    test.case("example 70")
    test.assert(commonmark("foo\n    # bar\n")
                == "<p>foo\n# bar</p>\n")
    test.case("example 71")
    test.assert(commonmark("## foo ##\n  ###   bar    ###\n")
                == "<h2>foo</h2>\n<h3>bar</h3>\n")
    test.case("example 72")
    test.assert(commonmark("# foo ##################################\n##### foo ##\n")
                == "<h1>foo</h1>\n<h5>foo</h5>\n")
    test.case("example 73")
    test.assert(commonmark("### foo ###     \n")
                == "<h3>foo</h3>\n")
    test.case("example 74")
    test.assert(commonmark("### foo ### b\n")
                == "<h3>foo ### b</h3>\n")
    test.case("example 75")
    test.assert(commonmark("# foo#\n")
                == "<h1>foo#</h1>\n")
    test.case("example 76")
    test.assert(commonmark("### foo \\###\n## foo #\\##\n# foo \\#\n")
                == "<h3>foo ###</h3>\n<h2>foo ###</h2>\n<h1>foo #</h1>\n")
    test.case("example 77")
    test.assert(commonmark("****\n## foo\n****\n")
                == "<hr />\n<h2>foo</h2>\n<hr />\n")
    test.case("example 78")
    test.assert(commonmark("Foo bar\n# baz\nBar foo\n")
                == "<p>Foo bar</p>\n<h1>baz</h1>\n<p>Bar foo</p>\n")
    test.case("example 79")
    test.assert(commonmark("## \n#\n### ###\n")
                == "<h2></h2>\n<h1></h1>\n<h3></h3>\n")

@test
fn test_setext_headings() [io]
    test.case("example 80")
    test.assert(commonmark("Foo *bar*\n=========\n\nFoo *bar*\n---------\n")
                == "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n")
    test.case("example 81")
    test.assert(commonmark("Foo *bar\nbaz*\n====\n")
                == "<h1>Foo <em>bar\nbaz</em></h1>\n")
    test.case("example 82")
    test.assert(commonmark("  Foo *bar\nbaz*\t\n====\n")
                == "<h1>Foo <em>bar\nbaz</em></h1>\n")
    test.case("example 83")
    test.assert(commonmark("Foo\n-------------------------\n\nFoo\n=\n")
                == "<h2>Foo</h2>\n<h1>Foo</h1>\n")
    test.case("example 84")
    test.assert(commonmark("   Foo\n---\n\n  Foo\n-----\n\n  Foo\n  ===\n")
                == "<h2>Foo</h2>\n<h2>Foo</h2>\n<h1>Foo</h1>\n")
    test.case("example 85")
    test.assert(commonmark("    Foo\n    ---\n\n    Foo\n---\n")
                == "<pre><code>Foo\n---\n\nFoo\n</code></pre>\n<hr />\n")
    test.case("example 86")
    test.assert(commonmark("Foo\n   ----      \n")
                == "<h2>Foo</h2>\n")
    test.case("example 87")
    test.assert(commonmark("Foo\n    ---\n")
                == "<p>Foo\n---</p>\n")
    test.case("example 88")
    test.assert(commonmark("Foo\n= =\n\nFoo\n--- -\n")
                == "<p>Foo\n= =</p>\n<p>Foo</p>\n<hr />\n")
    test.case("example 89")
    test.assert(commonmark("Foo  \n-----\n")
                == "<h2>Foo</h2>\n")
    test.case("example 90")
    test.assert(commonmark("Foo\\\n----\n")
                == "<h2>Foo\\</h2>\n")
    test.case("example 91")
    test.assert(commonmark("`Foo\n----\n`\n\n<a title=\"a lot\n---\nof dashes\"/>\n")
                == "<h2>`Foo</h2>\n<p>`</p>\n<h2>&lt;a title=&quot;a lot</h2>\n<p>of dashes&quot;/&gt;</p>\n")
    test.case("example 92")
    test.assert(commonmark("> Foo\n---\n")
                == "<blockquote>\n<p>Foo</p>\n</blockquote>\n<hr />\n")
    test.case("example 93")
    test.assert(commonmark("> foo\nbar\n===\n")
                == "<blockquote>\n<p>foo\nbar\n===</p>\n</blockquote>\n")
    test.case("example 94")
    test.assert(commonmark("- Foo\n---\n")
                == "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n")
    test.case("example 95")
    test.assert(commonmark("Foo\nBar\n---\n")
                == "<h2>Foo\nBar</h2>\n")
    test.case("example 96")
    test.assert(commonmark("---\nFoo\n---\nBar\n---\nBaz\n")
                == "<hr />\n<h2>Foo</h2>\n<h2>Bar</h2>\n<p>Baz</p>\n")
    test.case("example 97")
    test.assert(commonmark("\n====\n")
                == "<p>====</p>\n")
    test.case("example 98")
    test.assert(commonmark("---\n---\n")
                == "<hr />\n<hr />\n")
    test.case("example 99")
    test.assert(commonmark("- foo\n-----\n")
                == "<ul>\n<li>foo</li>\n</ul>\n<hr />\n")
    test.case("example 100")
    test.assert(commonmark("    foo\n---\n")
                == "<pre><code>foo\n</code></pre>\n<hr />\n")
    test.case("example 101")
    test.assert(commonmark("> foo\n-----\n")
                == "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n")
    test.case("example 102")
    test.assert(commonmark("\\> foo\n------\n")
                == "<h2>&gt; foo</h2>\n")
    test.case("example 103")
    test.assert(commonmark("Foo\n\nbar\n---\nbaz\n")
                == "<p>Foo</p>\n<h2>bar</h2>\n<p>baz</p>\n")
    test.case("example 104")
    test.assert(commonmark("Foo\nbar\n\n---\n\nbaz\n")
                == "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n")
    test.case("example 105")
    test.assert(commonmark("Foo\nbar\n* * *\nbaz\n")
                == "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n")
    test.case("example 106")
    test.assert(commonmark("Foo\nbar\n\\---\nbaz\n")
                == "<p>Foo\nbar\n---\nbaz</p>\n")

@test
fn test_indented_code_blocks() [io]
    test.case("example 107")
    test.assert(commonmark("    a simple\n      indented code block\n")
                == "<pre><code>a simple\n  indented code block\n</code></pre>\n")
    test.case("example 108")
    test.assert(commonmark("  - foo\n\n    bar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")
    test.case("example 109")
    test.assert(commonmark("1.  foo\n\n    - bar\n")
                == "<ol>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>\n")
    test.case("example 110")
    test.assert(commonmark("    <a/>\n    *hi*\n\n    - one\n")
                == "<pre><code>&lt;a/&gt;\n*hi*\n\n- one\n</code></pre>\n")
    test.case("example 111")
    test.assert(commonmark("    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n")
                == "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n")
    test.case("example 112")
    test.assert(commonmark("    chunk1\n      \n      chunk2\n")
                == "<pre><code>chunk1\n  \n  chunk2\n</code></pre>\n")
    test.case("example 113")
    test.assert(commonmark("Foo\n    bar\n\n")
                == "<p>Foo\nbar</p>\n")
    test.case("example 114")
    test.assert(commonmark("    foo\nbar\n")
                == "<pre><code>foo\n</code></pre>\n<p>bar</p>\n")
    test.case("example 115")
    test.assert(commonmark("# Heading\n    foo\nHeading\n------\n    foo\n----\n")
                == "<h1>Heading</h1>\n<pre><code>foo\n</code></pre>\n<h2>Heading</h2>\n<pre><code>foo\n</code></pre>\n<hr />\n")
    test.case("example 116")
    test.assert(commonmark("        foo\n    bar\n")
                == "<pre><code>    foo\nbar\n</code></pre>\n")
    test.case("example 117")
    test.assert(commonmark("\n    \n    foo\n    \n\n")
                == "<pre><code>foo\n</code></pre>\n")
    test.case("example 118")
    test.assert(commonmark("    foo  \n")
                == "<pre><code>foo  \n</code></pre>\n")

@test
fn test_fenced_code_blocks() [io]
    test.case("example 119")
    test.assert(commonmark("```\n<\n >\n```\n")
                == "<pre><code>&lt;\n &gt;\n</code></pre>\n")
    test.case("example 120")
    test.assert(commonmark("~~~\n<\n >\n~~~\n")
                == "<pre><code>&lt;\n &gt;\n</code></pre>\n")
    test.case("example 121")
    test.assert(commonmark("``\nfoo\n``\n")
                == "<p><code>foo</code></p>\n")
    test.case("example 122")
    test.assert(commonmark("```\naaa\n~~~\n```\n")
                == "<pre><code>aaa\n~~~\n</code></pre>\n")
    test.case("example 123")
    test.assert(commonmark("~~~\naaa\n```\n~~~\n")
                == "<pre><code>aaa\n```\n</code></pre>\n")
    test.case("example 124")
    test.assert(commonmark("````\naaa\n```\n``````\n")
                == "<pre><code>aaa\n```\n</code></pre>\n")
    test.case("example 125")
    test.assert(commonmark("~~~~\naaa\n~~~\n~~~~\n")
                == "<pre><code>aaa\n~~~\n</code></pre>\n")
    test.case("example 126")
    test.assert(commonmark("```\n")
                == "<pre><code></code></pre>\n")
    test.case("example 127")
    test.assert(commonmark("`````\n\n```\naaa\n")
                == "<pre><code>\n```\naaa\n</code></pre>\n")
    test.case("example 128")
    test.assert(commonmark("> ```\n> aaa\n\nbbb\n")
                == "<blockquote>\n<pre><code>aaa\n</code></pre>\n</blockquote>\n<p>bbb</p>\n")
    test.case("example 129")
    test.assert(commonmark("```\n\n  \n```\n")
                == "<pre><code>\n  \n</code></pre>\n")
    test.case("example 130")
    test.assert(commonmark("```\n```\n")
                == "<pre><code></code></pre>\n")
    test.case("example 131")
    test.assert(commonmark(" ```\n aaa\naaa\n```\n")
                == "<pre><code>aaa\naaa\n</code></pre>\n")
    test.case("example 132")
    test.assert(commonmark("  ```\naaa\n  aaa\naaa\n  ```\n")
                == "<pre><code>aaa\naaa\naaa\n</code></pre>\n")
    test.case("example 133")
    test.assert(commonmark("   ```\n   aaa\n    aaa\n  aaa\n   ```\n")
                == "<pre><code>aaa\n aaa\naaa\n</code></pre>\n")
    test.case("example 134")
    test.assert(commonmark("    ```\n    aaa\n    ```\n")
                == "<pre><code>```\naaa\n```\n</code></pre>\n")
    test.case("example 135")
    test.assert(commonmark("```\naaa\n  ```\n")
                == "<pre><code>aaa\n</code></pre>\n")
    test.case("example 136")
    test.assert(commonmark("   ```\naaa\n  ```\n")
                == "<pre><code>aaa\n</code></pre>\n")
    test.case("example 137")
    test.assert(commonmark("```\naaa\n    ```\n")
                == "<pre><code>aaa\n    ```\n</code></pre>\n")
    test.case("example 138")
    test.assert(commonmark("``` ```\naaa\n")
                == "<p><code> </code>\naaa</p>\n")
    test.case("example 139")
    test.assert(commonmark("~~~~~~\naaa\n~~~ ~~\n")
                == "<pre><code>aaa\n~~~ ~~\n</code></pre>\n")
    test.case("example 140")
    test.assert(commonmark("foo\n```\nbar\n```\nbaz\n")
                == "<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n")
    test.case("example 141")
    test.assert(commonmark("foo\n---\n~~~\nbar\n~~~\n# baz\n")
                == "<h2>foo</h2>\n<pre><code>bar\n</code></pre>\n<h1>baz</h1>\n")
    test.case("example 142")
    test.assert(commonmark("```ruby\ndef foo(x)\n  return 3\nend\n```\n")
                == "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n")
    test.case("example 143")
    test.assert(commonmark("~~~~    ruby startline=3 \$%@#\$\ndef foo(x)\n  return 3\nend\n~~~~~~~\n")
                == "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n")
    test.case("example 144")
    test.assert(commonmark("````;\n````\n")
                == "<pre><code class=\"language-;\"></code></pre>\n")
    test.case("example 145")
    test.assert(commonmark("``` aa ```\nfoo\n")
                == "<p><code>aa</code>\nfoo</p>\n")
    test.case("example 146")
    test.assert(commonmark("~~~ aa ``` ~~~\nfoo\n~~~\n")
                == "<pre><code class=\"language-aa\">foo\n</code></pre>\n")
    test.case("example 147")
    test.assert(commonmark("```\n``` aaa\n```\n")
                == "<pre><code>``` aaa\n</code></pre>\n")

@test
fn test_html_blocks() [io]
    test.case("example 148")
    test.assert(commonmark("<table><tr><td>\n<pre>\n**Hello**,\n\n_world_.\n</pre>\n</td></tr></table>\n")
                == "<table><tr><td>\n<pre>\n**Hello**,\n<p><em>world</em>.\n</pre></p>\n</td></tr></table>\n")
    test.case("example 149")
    test.assert(commonmark("<table>\n  <tr>\n    <td>\n           hi\n    </td>\n  </tr>\n</table>\n\nokay.\n")
                == "<table>\n  <tr>\n    <td>\n           hi\n    </td>\n  </tr>\n</table>\n<p>okay.</p>\n")
    test.case("example 150")
    test.assert(commonmark(" <div>\n  *hello*\n         <foo><a>\n")
                == " <div>\n  *hello*\n         <foo><a>\n")
    test.case("example 151")
    test.assert(commonmark("</div>\n*foo*\n")
                == "</div>\n*foo*\n")
    test.case("example 152")
    test.assert(commonmark("<DIV CLASS=\"foo\">\n\n*Markdown*\n\n</DIV>\n")
                == "<DIV CLASS=\"foo\">\n<p><em>Markdown</em></p>\n</DIV>\n")
    test.case("example 153")
    test.assert(commonmark("<div id=\"foo\"\n  class=\"bar\">\n</div>\n")
                == "<div id=\"foo\"\n  class=\"bar\">\n</div>\n")
    test.case("example 154")
    test.assert(commonmark("<div id=\"foo\" class=\"bar\n  baz\">\n</div>\n")
                == "<div id=\"foo\" class=\"bar\n  baz\">\n</div>\n")
    test.case("example 155")
    test.assert(commonmark("<div>\n*foo*\n\n*bar*\n")
                == "<div>\n*foo*\n<p><em>bar</em></p>\n")
    test.case("example 156")
    test.assert(commonmark("<div id=\"foo\"\n*hi*\n")
                == "<div id=\"foo\"\n*hi*\n")
    test.case("example 157")
    test.assert(commonmark("<div class\nfoo\n")
                == "<div class\nfoo\n")
    test.case("example 158")
    test.assert(commonmark("<div *???-&&&-<---\n*foo*\n")
                == "<div *???-&&&-<---\n*foo*\n")
    test.case("example 159")
    test.assert(commonmark("<div><a href=\"bar\">*foo*</a></div>\n")
                == "<div><a href=\"bar\">*foo*</a></div>\n")
    test.case("example 160")
    test.assert(commonmark("<table><tr><td>\nfoo\n</td></tr></table>\n")
                == "<table><tr><td>\nfoo\n</td></tr></table>\n")
    test.case("example 161")
    test.assert(commonmark("<div></div>\n``` c\nint x = 33;\n```\n")
                == "<div></div>\n``` c\nint x = 33;\n```\n")
    test.case("example 162")
    test.assert(commonmark("<a href=\"foo\">\n*bar*\n</a>\n")
                == "<a href=\"foo\">\n*bar*\n</a>\n")
    test.case("example 163")
    test.assert(commonmark("<Warning>\n*bar*\n</Warning>\n")
                == "<Warning>\n*bar*\n</Warning>\n")
    test.case("example 164")
    test.assert(commonmark("<i class=\"foo\">\n*bar*\n</i>\n")
                == "<i class=\"foo\">\n*bar*\n</i>\n")
    test.case("example 165")
    test.assert(commonmark("</ins>\n*bar*\n")
                == "</ins>\n*bar*\n")
    test.case("example 166")
    test.assert(commonmark("<del>\n*foo*\n</del>\n")
                == "<del>\n*foo*\n</del>\n")
    test.case("example 167")
    test.assert(commonmark("<del>\n\n*foo*\n\n</del>\n")
                == "<del>\n<p><em>foo</em></p>\n</del>\n")
    test.case("example 168")
    test.assert(commonmark("<del>*foo*</del>\n")
                == "<p><del><em>foo</em></del></p>\n")
    test.case("example 169")
    test.assert(commonmark("<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print \$ parseTags tags\n</code></pre>\nokay\n")
                == "<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print \$ parseTags tags\n</code></pre>\n<p>okay</p>\n")
    test.case("example 170")
    test.assert(commonmark("<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\nokay\n")
                == "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\n<p>okay</p>\n")
    test.case("example 171")
    test.assert(commonmark("<textarea>\n\n*foo*\n\n_bar_\n\n</textarea>\n")
                == "<textarea>\n\n*foo*\n\n_bar_\n\n</textarea>\n")
    test.case("example 172")
    test.assert(commonmark("<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\nokay\n")
                == "<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\n<p>okay</p>\n")
    test.case("example 173")
    test.assert(commonmark("<style\n  type=\"text/css\">\n\nfoo\n")
                == "<style\n  type=\"text/css\">\n\nfoo\n")
    test.case("example 174")
    test.assert(commonmark("> <div>\n> foo\n\nbar\n")
                == "<blockquote>\n<div>\nfoo\n</blockquote>\n<p>bar</p>\n")
    test.case("example 175")
    test.assert(commonmark("- <div>\n- foo\n")
                == "<ul>\n<li>\n<div>\n</li>\n<li>foo</li>\n</ul>\n")
    test.case("example 176")
    test.assert(commonmark("<style>p{color:red;}</style>\n*foo*\n")
                == "<style>p{color:red;}</style>\n<p><em>foo</em></p>\n")
    test.case("example 177")
    test.assert(commonmark("<!-- foo -->*bar*\n*baz*\n")
                == "<!-- foo -->*bar*\n<p><em>baz</em></p>\n")
    test.case("example 178")
    test.assert(commonmark("<script>\nfoo\n</script>1. *bar*\n")
                == "<script>\nfoo\n</script>1. *bar*\n")
    test.case("example 179")
    test.assert(commonmark("<!-- Foo\n\nbar\n   baz -->\nokay\n")
                == "<!-- Foo\n\nbar\n   baz -->\n<p>okay</p>\n")
    test.case("example 180")
    test.assert(commonmark("<?php\n\n  echo '>';\n\n?>\nokay\n")
                == "<?php\n\n  echo '>';\n\n?>\n<p>okay</p>\n")
    test.case("example 181")
    test.assert(commonmark("<!DOCTYPE html>\n")
                == "<!DOCTYPE html>\n")
    test.case("example 182")
    test.assert(commonmark("<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\nokay\n")
                == "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\n<p>okay</p>\n")
    test.case("example 183")
    test.assert(commonmark("  <!-- foo -->\n\n    <!-- foo -->\n")
                == "  <!-- foo -->\n<pre><code>&lt;!-- foo --&gt;\n</code></pre>\n")
    test.case("example 184")
    test.assert(commonmark("  <div>\n\n    <div>\n")
                == "  <div>\n<pre><code>&lt;div&gt;\n</code></pre>\n")
    test.case("example 185")
    test.assert(commonmark("Foo\n<div>\nbar\n</div>\n")
                == "<p>Foo</p>\n<div>\nbar\n</div>\n")
    test.case("example 186")
    test.assert(commonmark("<div>\nbar\n</div>\n*foo*\n")
                == "<div>\nbar\n</div>\n*foo*\n")
    test.case("example 187")
    test.assert(commonmark("Foo\n<a href=\"bar\">\nbaz\n")
                == "<p>Foo\n<a href=\"bar\">\nbaz</p>\n")
    test.case("example 188")
    test.assert(commonmark("<div>\n\n*Emphasized* text.\n\n</div>\n")
                == "<div>\n<p><em>Emphasized</em> text.</p>\n</div>\n")
    test.case("example 189")
    test.assert(commonmark("<div>\n*Emphasized* text.\n</div>\n")
                == "<div>\n*Emphasized* text.\n</div>\n")
    test.case("example 190")
    test.assert(commonmark("<table>\n\n<tr>\n\n<td>\nHi\n</td>\n\n</tr>\n\n</table>\n")
                == "<table>\n<tr>\n<td>\nHi\n</td>\n</tr>\n</table>\n")
    test.case("example 191")
    test.assert(commonmark("<table>\n\n  <tr>\n\n    <td>\n      Hi\n    </td>\n\n  </tr>\n\n</table>\n")
                == "<table>\n  <tr>\n<pre><code>&lt;td&gt;\n  Hi\n&lt;/td&gt;\n</code></pre>\n  </tr>\n</table>\n")

@test
fn test_link_reference_definitions() [io]
    test.case("example 192")
    test.assert(commonmark("[foo]: /url \"title\"\n\n[foo]\n")
                == "<p><a href=\"/url\" title=\"title\">foo</a></p>\n")
    test.case("example 193")
    test.assert(commonmark("   [foo]: \n      /url  \n           'the title'  \n\n[foo]\n")
                == "<p><a href=\"/url\" title=\"the title\">foo</a></p>\n")
    test.case("example 194")
    test.assert(commonmark("[Foo*bar\\]]:my_(url) 'title (with parens)'\n\n[Foo*bar\\]]\n")
                == "<p><a href=\"my_(url)\" title=\"title (with parens)\">Foo*bar]</a></p>\n")
    test.case("example 195")
    test.assert(commonmark("[Foo bar]:\n<my url>\n'title'\n\n[Foo bar]\n")
                == "<p><a href=\"my%20url\" title=\"title\">Foo bar</a></p>\n")
    test.case("example 196")
    test.assert(commonmark("[foo]: /url '\ntitle\nline1\nline2\n'\n\n[foo]\n")
                == "<p><a href=\"/url\" title=\"\ntitle\nline1\nline2\n\">foo</a></p>\n")
    test.case("example 197")
    test.assert(commonmark("[foo]: /url 'title\n\nwith blank line'\n\n[foo]\n")
                == "<p>[foo]: /url 'title</p>\n<p>with blank line'</p>\n<p>[foo]</p>\n")
    test.case("example 198")
    test.assert(commonmark("[foo]:\n/url\n\n[foo]\n")
                == "<p><a href=\"/url\">foo</a></p>\n")
    test.case("example 199")
    test.assert(commonmark("[foo]:\n\n[foo]\n")
                == "<p>[foo]:</p>\n<p>[foo]</p>\n")
    test.case("example 200")
    test.assert(commonmark("[foo]: <>\n\n[foo]\n")
                == "<p><a href=\"\">foo</a></p>\n")
    test.case("example 201")
    test.assert(commonmark("[foo]: <bar>(baz)\n\n[foo]\n")
                == "<p>[foo]: <bar>(baz)</p>\n<p>[foo]</p>\n")
    test.case("example 202")
    test.assert(commonmark("[foo]: /url\\bar\\*baz \"foo\\\"bar\\baz\"\n\n[foo]\n")
                == "<p><a href=\"/url%5Cbar*baz\" title=\"foo&quot;bar\\baz\">foo</a></p>\n")
    test.case("example 203")
    test.assert(commonmark("[foo]\n\n[foo]: url\n")
                == "<p><a href=\"url\">foo</a></p>\n")
    test.case("example 204")
    test.assert(commonmark("[foo]\n\n[foo]: first\n[foo]: second\n")
                == "<p><a href=\"first\">foo</a></p>\n")
    test.case("example 205")
    test.assert(commonmark("[FOO]: /url\n\n[Foo]\n")
                == "<p><a href=\"/url\">Foo</a></p>\n")
    test.case("example 206")
    test.assert(commonmark("[ΑΓΩ]: /φου\n\n[αγω]\n")
                == "<p><a href=\"/%CF%86%CE%BF%CF%85\">αγω</a></p>\n")
    test.case("example 207")
    test.assert(commonmark("[foo]: /url\n")
                == "")
    test.case("example 208")
    test.assert(commonmark("[\nfoo\n]: /url\nbar\n")
                == "<p>bar</p>\n")
    test.case("example 209")
    test.assert(commonmark("[foo]: /url \"title\" ok\n")
                == "<p>[foo]: /url &quot;title&quot; ok</p>\n")
    test.case("example 210")
    test.assert(commonmark("[foo]: /url\n\"title\" ok\n")
                == "<p>&quot;title&quot; ok</p>\n")
    test.case("example 211")
    test.assert(commonmark("    [foo]: /url \"title\"\n\n[foo]\n")
                == "<pre><code>[foo]: /url &quot;title&quot;\n</code></pre>\n<p>[foo]</p>\n")
    test.case("example 212")
    test.assert(commonmark("```\n[foo]: /url\n```\n\n[foo]\n")
                == "<pre><code>[foo]: /url\n</code></pre>\n<p>[foo]</p>\n")
    test.case("example 213")
    test.assert(commonmark("Foo\n[bar]: /baz\n\n[bar]\n")
                == "<p>Foo\n[bar]: /baz</p>\n<p>[bar]</p>\n")
    test.case("example 214")
    test.assert(commonmark("# [Foo]\n[foo]: /url\n> bar\n")
                == "<h1><a href=\"/url\">Foo</a></h1>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    test.case("example 215")
    test.assert(commonmark("[foo]: /url\nbar\n===\n[foo]\n")
                == "<h1>bar</h1>\n<p><a href=\"/url\">foo</a></p>\n")
    test.case("example 216")
    test.assert(commonmark("[foo]: /url\n===\n[foo]\n")
                == "<p>===\n<a href=\"/url\">foo</a></p>\n")
    test.case("example 217")
    test.assert(commonmark("[foo]: /foo-url \"foo\"\n[bar]: /bar-url\n  \"bar\"\n[baz]: /baz-url\n\n[foo],\n[bar],\n[baz]\n")
                == "<p><a href=\"/foo-url\" title=\"foo\">foo</a>,\n<a href=\"/bar-url\" title=\"bar\">bar</a>,\n<a href=\"/baz-url\">baz</a></p>\n")
    test.case("example 218")
    test.assert(commonmark("[foo]\n\n> [foo]: /url\n")
                == "<p><a href=\"/url\">foo</a></p>\n<blockquote>\n</blockquote>\n")

@test
fn test_paragraphs() [io]
    test.case("example 219")
    test.assert(commonmark("aaa\n\nbbb\n")
                == "<p>aaa</p>\n<p>bbb</p>\n")
    test.case("example 220")
    test.assert(commonmark("aaa\nbbb\n\nccc\nddd\n")
                == "<p>aaa\nbbb</p>\n<p>ccc\nddd</p>\n")
    test.case("example 221")
    test.assert(commonmark("aaa\n\n\nbbb\n")
                == "<p>aaa</p>\n<p>bbb</p>\n")
    test.case("example 222")
    test.assert(commonmark("  aaa\n bbb\n")
                == "<p>aaa\nbbb</p>\n")
    test.case("example 223")
    test.assert(commonmark("aaa\n             bbb\n                                       ccc\n")
                == "<p>aaa\nbbb\nccc</p>\n")
    test.case("example 224")
    test.assert(commonmark("   aaa\nbbb\n")
                == "<p>aaa\nbbb</p>\n")
    test.case("example 225")
    test.assert(commonmark("    aaa\nbbb\n")
                == "<pre><code>aaa\n</code></pre>\n<p>bbb</p>\n")
    test.case("example 226")
    test.assert(commonmark("aaa     \nbbb     \n")
                == "<p>aaa<br />\nbbb</p>\n")

@test
fn test_blank_lines() [io]
    test.case("example 227")
    test.assert(commonmark("  \n\naaa\n  \n\n# aaa\n\n  \n")
                == "<p>aaa</p>\n<h1>aaa</h1>\n")

@test
fn test_block_quotes() [io]
    test.case("example 228")
    test.assert(commonmark("> # Foo\n> bar\n> baz\n")
                == "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    test.case("example 229")
    test.assert(commonmark("># Foo\n>bar\n> baz\n")
                == "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    test.case("example 230")
    test.assert(commonmark("   > # Foo\n   > bar\n > baz\n")
                == "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    test.case("example 231")
    test.assert(commonmark("    > # Foo\n    > bar\n    > baz\n")
                == "<pre><code>&gt; # Foo\n&gt; bar\n&gt; baz\n</code></pre>\n")
    test.case("example 232")
    test.assert(commonmark("> # Foo\n> bar\nbaz\n")
                == "<blockquote>\n<h1>Foo</h1>\n<p>bar\nbaz</p>\n</blockquote>\n")
    test.case("example 233")
    test.assert(commonmark("> bar\nbaz\n> foo\n")
                == "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n")
    test.case("example 234")
    test.assert(commonmark("> foo\n---\n")
                == "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n")
    test.case("example 235")
    test.assert(commonmark("> - foo\n- bar\n")
                == "<blockquote>\n<ul>\n<li>foo</li>\n</ul>\n</blockquote>\n<ul>\n<li>bar</li>\n</ul>\n")
    test.case("example 236")
    test.assert(commonmark(">     foo\n    bar\n")
                == "<blockquote>\n<pre><code>foo\n</code></pre>\n</blockquote>\n<pre><code>bar\n</code></pre>\n")
    test.case("example 237")
    test.assert(commonmark("> ```\nfoo\n```\n")
                == "<blockquote>\n<pre><code></code></pre>\n</blockquote>\n<p>foo</p>\n<pre><code></code></pre>\n")
    test.case("example 238")
    test.assert(commonmark("> foo\n    - bar\n")
                == "<blockquote>\n<p>foo\n- bar</p>\n</blockquote>\n")
    test.case("example 239")
    test.assert(commonmark(">\n")
                == "<blockquote>\n</blockquote>\n")
    test.case("example 240")
    test.assert(commonmark(">\n>  \n> \n")
                == "<blockquote>\n</blockquote>\n")
    test.case("example 241")
    test.assert(commonmark(">\n> foo\n>  \n")
                == "<blockquote>\n<p>foo</p>\n</blockquote>\n")
    test.case("example 242")
    test.assert(commonmark("> foo\n\n> bar\n")
                == "<blockquote>\n<p>foo</p>\n</blockquote>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    test.case("example 243")
    test.assert(commonmark("> foo\n> bar\n")
                == "<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n")
    test.case("example 244")
    test.assert(commonmark("> foo\n>\n> bar\n")
                == "<blockquote>\n<p>foo</p>\n<p>bar</p>\n</blockquote>\n")
    test.case("example 245")
    test.assert(commonmark("foo\n> bar\n")
                == "<p>foo</p>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    test.case("example 246")
    test.assert(commonmark("> aaa\n***\n> bbb\n")
                == "<blockquote>\n<p>aaa</p>\n</blockquote>\n<hr />\n<blockquote>\n<p>bbb</p>\n</blockquote>\n")
    test.case("example 247")
    test.assert(commonmark("> bar\nbaz\n")
                == "<blockquote>\n<p>bar\nbaz</p>\n</blockquote>\n")
    test.case("example 248")
    test.assert(commonmark("> bar\n\nbaz\n")
                == "<blockquote>\n<p>bar</p>\n</blockquote>\n<p>baz</p>\n")
    test.case("example 249")
    test.assert(commonmark("> bar\n>\nbaz\n")
                == "<blockquote>\n<p>bar</p>\n</blockquote>\n<p>baz</p>\n")
    test.case("example 250")
    test.assert(commonmark("> > > foo\nbar\n")
                == "<blockquote>\n<blockquote>\n<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n</blockquote>\n</blockquote>\n")
    test.case("example 251")
    test.assert(commonmark(">>> foo\n> bar\n>>baz\n")
                == "<blockquote>\n<blockquote>\n<blockquote>\n<p>foo\nbar\nbaz</p>\n</blockquote>\n</blockquote>\n</blockquote>\n")
    test.case("example 252")
    test.assert(commonmark(">     code\n\n>    not code\n")
                == "<blockquote>\n<pre><code>code\n</code></pre>\n</blockquote>\n<blockquote>\n<p>not code</p>\n</blockquote>\n")

@test
fn test_list_items() [io]
    test.case("example 253")
    test.assert(commonmark("A paragraph\nwith two lines.\n\n    indented code\n\n> A block quote.\n")
                == "<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n")
    test.case("example 254")
    test.assert(commonmark("1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n")
                == "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 255")
    test.assert(commonmark("- one\n\n two\n")
                == "<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n")
    test.case("example 256")
    test.assert(commonmark("- one\n\n  two\n")
                == "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")
    test.case("example 257")
    test.assert(commonmark(" -    one\n\n     two\n")
                == "<ul>\n<li>one</li>\n</ul>\n<pre><code> two\n</code></pre>\n")
    test.case("example 258")
    test.assert(commonmark(" -    one\n\n      two\n")
                == "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n")
    test.case("example 259")
    test.assert(commonmark("   > > 1.  one\n>>\n>>     two\n")
                == "<blockquote>\n<blockquote>\n<ol>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ol>\n</blockquote>\n</blockquote>\n")
    test.case("example 260")
    test.assert(commonmark(">>- one\n>>\n  >  > two\n")
                == "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n</blockquote>\n</blockquote>\n")
    test.case("example 261")
    test.assert(commonmark("-one\n\n2.two\n")
                == "<p>-one</p>\n<p>2.two</p>\n")
    test.case("example 262")
    test.assert(commonmark("- foo\n\n\n  bar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")
    test.case("example 263")
    test.assert(commonmark("1.  foo\n\n    ```\n    bar\n    ```\n\n    baz\n\n    > bam\n")
                == "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n<blockquote>\n<p>bam</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 264")
    test.assert(commonmark("- Foo\n\n      bar\n\n\n      baz\n")
                == "<ul>\n<li>\n<p>Foo</p>\n<pre><code>bar\n\n\nbaz\n</code></pre>\n</li>\n</ul>\n")
    test.case("example 265")
    test.assert(commonmark("123456789. ok\n")
                == "<ol start=\"123456789\">\n<li>ok</li>\n</ol>\n")
    test.case("example 266")
    test.assert(commonmark("1234567890. not ok\n")
                == "<p>1234567890. not ok</p>\n")
    test.case("example 267")
    test.assert(commonmark("0. ok\n")
                == "<ol start=\"0\">\n<li>ok</li>\n</ol>\n")
    test.case("example 268")
    test.assert(commonmark("003. ok\n")
                == "<ol start=\"3\">\n<li>ok</li>\n</ol>\n")
    test.case("example 269")
    test.assert(commonmark("-1. not ok\n")
                == "<p>-1. not ok</p>\n")
    test.case("example 270")
    test.assert(commonmark("- foo\n\n      bar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ul>\n")
    test.case("example 271")
    test.assert(commonmark("  10.  foo\n\n           bar\n")
                == "<ol start=\"10\">\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ol>\n")
    test.case("example 272")
    test.assert(commonmark("    indented code\n\nparagraph\n\n    more code\n")
                == "<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n")
    test.case("example 273")
    test.assert(commonmark("1.     indented code\n\n   paragraph\n\n       more code\n")
                == "<ol>\n<li>\n<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>\n")
    test.case("example 274")
    test.assert(commonmark("1.      indented code\n\n   paragraph\n\n       more code\n")
                == "<ol>\n<li>\n<pre><code> indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>\n")
    test.case("example 275")
    test.assert(commonmark("   foo\n\nbar\n")
                == "<p>foo</p>\n<p>bar</p>\n")
    test.case("example 276")
    test.assert(commonmark("-    foo\n\n  bar\n")
                == "<ul>\n<li>foo</li>\n</ul>\n<p>bar</p>\n")
    test.case("example 277")
    test.assert(commonmark("-  foo\n\n   bar\n")
                == "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n")
    test.case("example 278")
    test.assert(commonmark("-\n  foo\n-\n  ```\n  bar\n  ```\n-\n      baz\n")
                == "<ul>\n<li>foo</li>\n<li>\n<pre><code>bar\n</code></pre>\n</li>\n<li>\n<pre><code>baz\n</code></pre>\n</li>\n</ul>\n")
    test.case("example 279")
    test.assert(commonmark("-   \n  foo\n")
                == "<ul>\n<li>foo</li>\n</ul>\n")
    test.case("example 280")
    test.assert(commonmark("-\n\n  foo\n")
                == "<ul>\n<li></li>\n</ul>\n<p>foo</p>\n")
    test.case("example 281")
    test.assert(commonmark("- foo\n-\n- bar\n")
                == "<ul>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ul>\n")
    test.case("example 282")
    test.assert(commonmark("- foo\n-   \n- bar\n")
                == "<ul>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ul>\n")
    test.case("example 283")
    test.assert(commonmark("1. foo\n2.\n3. bar\n")
                == "<ol>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ol>\n")
    test.case("example 284")
    test.assert(commonmark("*\n")
                == "<ul>\n<li></li>\n</ul>\n")
    test.case("example 285")
    test.assert(commonmark("foo\n*\n\nfoo\n1.\n")
                == "<p>foo\n*</p>\n<p>foo\n1.</p>\n")
    test.case("example 286")
    test.assert(commonmark(" 1.  A paragraph\n     with two lines.\n\n         indented code\n\n     > A block quote.\n")
                == "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 287")
    test.assert(commonmark("  1.  A paragraph\n      with two lines.\n\n          indented code\n\n      > A block quote.\n")
                == "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 288")
    test.assert(commonmark("   1.  A paragraph\n       with two lines.\n\n           indented code\n\n       > A block quote.\n")
                == "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 289")
    test.assert(commonmark("    1.  A paragraph\n        with two lines.\n\n            indented code\n\n        > A block quote.\n")
                == "<pre><code>1.  A paragraph\n    with two lines.\n\n        indented code\n\n    &gt; A block quote.\n</code></pre>\n")
    test.case("example 290")
    test.assert(commonmark("  1.  A paragraph\nwith two lines.\n\n          indented code\n\n      > A block quote.\n")
                == "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n")
    test.case("example 291")
    test.assert(commonmark("  1.  A paragraph\n    with two lines.\n")
                == "<ol>\n<li>A paragraph\nwith two lines.</li>\n</ol>\n")
    test.case("example 292")
    test.assert(commonmark("> 1. > Blockquote\ncontinued here.\n")
                == "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote\ncontinued here.</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>\n")
    test.case("example 293")
    test.assert(commonmark("> 1. > Blockquote\n> continued here.\n")
                == "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote\ncontinued here.</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>\n")
    test.case("example 294")
    test.assert(commonmark("- foo\n  - bar\n    - baz\n      - boo\n")
                == "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz\n<ul>\n<li>boo</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n")
    test.case("example 295")
    test.assert(commonmark("- foo\n - bar\n  - baz\n   - boo\n")
                == "<ul>\n<li>foo</li>\n<li>bar</li>\n<li>baz</li>\n<li>boo</li>\n</ul>\n")
    test.case("example 296")
    test.assert(commonmark("10) foo\n    - bar\n")
                == "<ol start=\"10\">\n<li>foo\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>\n")
    test.case("example 297")
    test.assert(commonmark("10) foo\n   - bar\n")
                == "<ol start=\"10\">\n<li>foo</li>\n</ol>\n<ul>\n<li>bar</li>\n</ul>\n")
    test.case("example 298")
    test.assert(commonmark("- - foo\n")
                == "<ul>\n<li>\n<ul>\n<li>foo</li>\n</ul>\n</li>\n</ul>\n")
    test.case("example 299")
    test.assert(commonmark("1. - 2. foo\n")
                == "<ol>\n<li>\n<ul>\n<li>\n<ol start=\"2\">\n<li>foo</li>\n</ol>\n</li>\n</ul>\n</li>\n</ol>\n")
    test.case("example 300")
    test.assert(commonmark("- # Foo\n- Bar\n  ---\n  baz\n")
                == "<ul>\n<li>\n<h1>Foo</h1>\n</li>\n<li>\n<h2>Bar</h2>\nbaz</li>\n</ul>\n")

@test
fn test_lists() [io]
    test.case("example 301")
    test.assert(commonmark("- foo\n- bar\n+ baz\n")
                == "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<ul>\n<li>baz</li>\n</ul>\n")
    test.case("example 302")
    test.assert(commonmark("1. foo\n2. bar\n3) baz\n")
                == "<ol>\n<li>foo</li>\n<li>bar</li>\n</ol>\n<ol start=\"3\">\n<li>baz</li>\n</ol>\n")
    test.case("example 303")
    test.assert(commonmark("Foo\n- bar\n- baz\n")
                == "<p>Foo</p>\n<ul>\n<li>bar</li>\n<li>baz</li>\n</ul>\n")
    test.case("example 304")
    test.assert(commonmark("The number of windows in my house is\n14.  The number of doors is 6.\n")
                == "<p>The number of windows in my house is\n14.  The number of doors is 6.</p>\n")
    test.case("example 305")
    test.assert(commonmark("The number of windows in my house is\n1.  The number of doors is 6.\n")
                == "<p>The number of windows in my house is</p>\n<ol>\n<li>The number of doors is 6.</li>\n</ol>\n")
    test.case("example 306")
    test.assert(commonmark("- foo\n\n- bar\n\n\n- baz\n")
                == "<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>bar</p>\n</li>\n<li>\n<p>baz</p>\n</li>\n</ul>\n")
    test.case("example 307")
    test.assert(commonmark("- foo\n  - bar\n    - baz\n\n\n      bim\n")
                == "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>\n<p>baz</p>\n<p>bim</p>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n")
    test.case("example 308")
    test.assert(commonmark("- foo\n- bar\n\n<!-- -->\n\n- baz\n- bim\n")
                == "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<!-- -->\n<ul>\n<li>baz</li>\n<li>bim</li>\n</ul>\n")
    test.case("example 309")
    test.assert(commonmark("-   foo\n\n    notcode\n\n-   foo\n\n<!-- -->\n\n    code\n")
                == "<ul>\n<li>\n<p>foo</p>\n<p>notcode</p>\n</li>\n<li>\n<p>foo</p>\n</li>\n</ul>\n<!-- -->\n<pre><code>code\n</code></pre>\n")
    test.case("example 310")
    test.assert(commonmark("- a\n - b\n  - c\n   - d\n  - e\n - f\n- g\n")
                == "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d</li>\n<li>e</li>\n<li>f</li>\n<li>g</li>\n</ul>\n")
    test.case("example 311")
    test.assert(commonmark("1. a\n\n  2. b\n\n   3. c\n")
                == "<ol>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ol>\n")
    test.case("example 312")
    test.assert(commonmark("- a\n - b\n  - c\n   - d\n    - e\n")
                == "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d\n- e</li>\n</ul>\n")
    test.case("example 313")
    test.assert(commonmark("1. a\n\n  2. b\n\n    3. c\n")
                == "<ol>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ol>\n<pre><code>3. c\n</code></pre>\n")
    test.case("example 314")
    test.assert(commonmark("- a\n- b\n\n- c\n")
                == "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>c</p>\n</li>\n</ul>\n")
    test.case("example 315")
    test.assert(commonmark("* a\n*\n\n* c\n")
                == "<ul>\n<li>\n<p>a</p>\n</li>\n<li></li>\n<li>\n<p>c</p>\n</li>\n</ul>\n")
    test.case("example 316")
    test.assert(commonmark("- a\n- b\n\n  c\n- d\n")
                == "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n<li>\n<p>d</p>\n</li>\n</ul>\n")
    test.case("example 317")
    test.assert(commonmark("- a\n- b\n\n  [ref]: /url\n- d\n")
                == "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n<li>\n<p>d</p>\n</li>\n</ul>\n")
    test.case("example 318")
    test.assert(commonmark("- a\n- ```\n  b\n\n\n  ```\n- c\n")
                == "<ul>\n<li>a</li>\n<li>\n<pre><code>b\n\n\n</code></pre>\n</li>\n<li>c</li>\n</ul>\n")
    test.case("example 319")
    test.assert(commonmark("- a\n  - b\n\n    c\n- d\n")
                == "<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n")
    test.case("example 320")
    test.assert(commonmark("* a\n  > b\n  >\n* c\n")
                == "<ul>\n<li>a\n<blockquote>\n<p>b</p>\n</blockquote>\n</li>\n<li>c</li>\n</ul>\n")
    test.case("example 321")
    test.assert(commonmark("- a\n  > b\n  ```\n  c\n  ```\n- d\n")
                == "<ul>\n<li>a\n<blockquote>\n<p>b</p>\n</blockquote>\n<pre><code>c\n</code></pre>\n</li>\n<li>d</li>\n</ul>\n")
    test.case("example 322")
    test.assert(commonmark("- a\n")
                == "<ul>\n<li>a</li>\n</ul>\n")
    test.case("example 323")
    test.assert(commonmark("- a\n  - b\n")
                == "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n")
    test.case("example 324")
    test.assert(commonmark("1. ```\n   foo\n   ```\n\n   bar\n")
                == "<ol>\n<li>\n<pre><code>foo\n</code></pre>\n<p>bar</p>\n</li>\n</ol>\n")
    test.case("example 325")
    test.assert(commonmark("* foo\n  * bar\n\n  baz\n")
                == "<ul>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n<p>baz</p>\n</li>\n</ul>\n")
    test.case("example 326")
    test.assert(commonmark("- a\n  - b\n  - c\n\n- d\n  - e\n  - f\n")
                == "<ul>\n<li>\n<p>a</p>\n<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n</li>\n<li>\n<p>d</p>\n<ul>\n<li>e</li>\n<li>f</li>\n</ul>\n</li>\n</ul>\n")

@test
fn test_inlines() [io]
    test.case("example 327")
    test.assert(commonmark("`hi`lo`\n")
                == "<p><code>hi</code>lo`</p>\n")

@test
fn test_code_spans() [io]
    test.case("example 328")
    test.assert(commonmark("`foo`\n")
                == "<p><code>foo</code></p>\n")
    test.case("example 329")
    test.assert(commonmark("`` foo ` bar ``\n")
                == "<p><code>foo ` bar</code></p>\n")
    test.case("example 330")
    test.assert(commonmark("` `` `\n")
                == "<p><code>``</code></p>\n")
    test.case("example 331")
    test.assert(commonmark("`  ``  `\n")
                == "<p><code> `` </code></p>\n")
    test.case("example 332")
    test.assert(commonmark("` a`\n")
                == "<p><code> a</code></p>\n")
    test.case("example 333")
    test.assert(commonmark("` b `\n")
                == "<p><code> b </code></p>\n")
    test.case("example 334")
    test.assert(commonmark("` `\n`  `\n")
                == "<p><code> </code>\n<code>  </code></p>\n")
    test.case("example 335")
    test.assert(commonmark("``\nfoo\nbar  \nbaz\n``\n")
                == "<p><code>foo bar   baz</code></p>\n")
    test.case("example 336")
    test.assert(commonmark("``\nfoo \n``\n")
                == "<p><code>foo </code></p>\n")
    test.case("example 337")
    test.assert(commonmark("`foo   bar \nbaz`\n")
                == "<p><code>foo   bar  baz</code></p>\n")
    test.case("example 338")
    test.assert(commonmark("`foo\\`bar`\n")
                == "<p><code>foo\\</code>bar`</p>\n")
    test.case("example 339")
    test.assert(commonmark("``foo`bar``\n")
                == "<p><code>foo`bar</code></p>\n")
    test.case("example 340")
    test.assert(commonmark("` foo `` bar `\n")
                == "<p><code>foo `` bar</code></p>\n")
    test.case("example 341")
    test.assert(commonmark("*foo`*`\n")
                == "<p>*foo<code>*</code></p>\n")
    test.case("example 342")
    test.assert(commonmark("[not a `link](/foo`)\n")
                == "<p>[not a <code>link](/foo</code>)</p>\n")
    test.case("example 343")
    test.assert(commonmark("`<a href=\"`\">`\n")
                == "<p><code>&lt;a href=&quot;</code>&quot;&gt;`</p>\n")
    test.case("example 344")
    test.assert(commonmark("<a href=\"`\">`\n")
                == "<p><a href=\"`\">`</p>\n")
    test.case("example 345")
    test.assert(commonmark("`<https://foo.bar.`baz>`\n")
                == "<p><code>&lt;https://foo.bar.</code>baz&gt;`</p>\n")
    test.case("example 346")
    test.assert(commonmark("<https://foo.bar.`baz>`\n")
                == "<p><a href=\"https://foo.bar.%60baz\">https://foo.bar.`baz</a>`</p>\n")
    test.case("example 347")
    test.assert(commonmark("```foo``\n")
                == "<p>```foo``</p>\n")
    test.case("example 348")
    test.assert(commonmark("`foo\n")
                == "<p>`foo</p>\n")
    test.case("example 349")
    test.assert(commonmark("`foo``bar``\n")
                == "<p>`foo<code>bar</code></p>\n")

@test
fn test_emphasis_and_strong_emphasis() [io]
    test.case("example 350")
    test.assert(commonmark("*foo bar*\n")
                == "<p><em>foo bar</em></p>\n")
    test.case("example 351")
    test.assert(commonmark("a * foo bar*\n")
                == "<p>a * foo bar*</p>\n")
    test.case("example 352")
    test.assert(commonmark("a*\"foo\"*\n")
                == "<p>a*&quot;foo&quot;*</p>\n")
    test.case("example 353")
    test.assert(commonmark("* a *\n")
                == "<p>* a *</p>\n")
    test.case("example 354")
    test.assert(commonmark("*\$*alpha.\n\n*£*bravo.\n\n*€*charlie.\n")
                == "<p>*\$*alpha.</p>\n<p>*£*bravo.</p>\n<p>*€*charlie.</p>\n")
    test.case("example 355")
    test.assert(commonmark("foo*bar*\n")
                == "<p>foo<em>bar</em></p>\n")
    test.case("example 356")
    test.assert(commonmark("5*6*78\n")
                == "<p>5<em>6</em>78</p>\n")
    test.case("example 357")
    test.assert(commonmark("_foo bar_\n")
                == "<p><em>foo bar</em></p>\n")
    test.case("example 358")
    test.assert(commonmark("_ foo bar_\n")
                == "<p>_ foo bar_</p>\n")
    test.case("example 359")
    test.assert(commonmark("a_\"foo\"_\n")
                == "<p>a_&quot;foo&quot;_</p>\n")
    test.case("example 360")
    test.assert(commonmark("foo_bar_\n")
                == "<p>foo_bar_</p>\n")
    test.case("example 361")
    test.assert(commonmark("5_6_78\n")
                == "<p>5_6_78</p>\n")
    test.case("example 362")
    test.assert(commonmark("пристаням_стремятся_\n")
                == "<p>пристаням_стремятся_</p>\n")
    test.case("example 363")
    test.assert(commonmark("aa_\"bb\"_cc\n")

// mdhtml.nv — events into HTML, appended to a buffer the caller owns.
//
// Every function takes the buffer to append to and answers it, so a
// caller can render many documents into one buffer and write once.
// The markup is cmark's, the reference implementation's, byte for
// byte, which is what the CommonMark specification's examples show;
// the GFM extensions are written as cmark-gfm writes them.
//
// Raw HTML is escaped by default.  CommonMark section 6.6 says to pass
// it through, and `RawPass` does; the default is `RawEscape` because
// the usual input is a document somebody else wrote, and passed-through
// `<script>` runs on the reader's page.
//
// A link destination passes a rule the caller supplies before it is
// written.  `web_urls` is the default: `http:`, `https:`, `mailto:`, a
// `#` fragment or a `/` site-absolute path, and every other destination
// becomes `#`.  The destination is the one thing a document author
// writes that reaches the page as markup rather than as text, and
// `javascript:` in an `href` is script on the page.

use std.str
use std.list
use std.bytes
use mdscan
use mdparse
use mdtree

// MdRawHtml is what the renderer does with raw HTML in the source.
pub enum MdRawHtml
    // Escape it, so it appears on the page as the text it was written
    // as.  The default.
    RawEscape
    // Pass it through, which is what CommonMark says.
    RawPass
    // Leave it out.
    RawDrop

// MdUrlRule is a rule for whether a link destination may be written.
pub struct MdUrlRule
    // True to write the destination as given, false to write `refused`
    // in its place.
    allows: fn(Str) -> Bool
    // What a refused destination becomes.
    refused: Str

// MdHtmlOptions is how a document is read and written.
pub struct MdHtmlOptions
    var raw_html: MdRawHtml
    var url_rule: MdUrlRule
    // Prepended to every generated heading id, so that two documents
    // rendered into one page do not collide.  Empty for none.
    var heading_id_prefix: Str
    // Write an `id` on every heading: the document's `{#anchor}` when
    // it wrote one, and one generated from the heading's text
    // otherwise.
    var heading_ids: Bool
    // Close void elements as `<br />` rather than `<br>`.  The
    // CommonMark examples use the first form, so both named option sets
    // turn it on.
    var xhtml: Bool
    // Write `<code class="language-novo">` from a fenced block's info
    // string.
    var code_language_class: Bool
    // How `render`, `render_str` and `to_plain` read the source.
    var markdown: mdparse.MdOptions

// web_urls is the default URL rule: `http:`, `https:`, `mailto:`, a
// `#` fragment, or a `/` site-absolute path.  Every other destination,
// `javascript:` and `data:` among them, becomes `#`.
//
// ```novo
// use mdhtml
//
// println(mdhtml.web_urls().refused)   // #
// ```
pub fn web_urls() -> MdUrlRule []
    MdUrlRule { allows: web_url, refused: "#" }

fn web_url(dest: Str) -> Bool
    let u = str.lower(dest)
    str.starts_with(u, "http://") or str.starts_with(u, "https://")
        or str.starts_with(u, "mailto:") or str.starts_with(u, "#")
        or str.starts_with(u, "/") and not str.starts_with(u, "//")

// any_url allows every destination, for a caller rendering documents
// it controls.
//
// ```novo
// use mdhtml
//
// println(if (mdhtml.any_url().allows)("file:///x") then "allowed" else "refused")
// ```
pub fn any_url() -> MdUrlRule []
    MdUrlRule { allows: every_url, refused: "#" }

fn every_url(dest: Str) -> Bool
    true

// url_rule builds a rule from a predicate and the text a refused
// destination becomes.
//
// ```novo
// use mdhtml
//
// fn https_only(dest: Str) -> Bool
//     str.starts_with(dest, "https://")
//
// println(mdhtml.url_rule(https_only, "about:blank").refused)   // about:blank
// ```
pub fn url_rule(allows: fn(Str) -> Bool, refused: Str) -> MdUrlRule []
    MdUrlRule { allows: allows, refused: refused }

// default_options is the safe rendering: raw HTML escaped, `web_urls`,
// heading ids on, and the source read with `mdparse.default_options`.
//
// ```novo
// use mdhtml
//
// println(if mdhtml.default_options().heading_ids then "ids" else "no ids")   // ids
// ```
pub fn default_options() -> MdHtmlOptions []
    MdHtmlOptions { raw_html: RawEscape, url_rule: web_urls(), heading_id_prefix: "",
                    heading_ids: true, xhtml: true, code_language_class: true,
                    markdown: mdparse.default_options() }

// commonmark_options is what the CommonMark specification says: raw
// HTML passed through, every destination allowed, no heading ids, and
// the source read as strict CommonMark.  The configuration its examples
// are compared under.
//
// ```novo
// use mdhtml
//
// print(mdhtml.render_str("<b>x</b>\n", mdhtml.commonmark_options()))   // <p><b>x</b></p>
// ```
pub fn commonmark_options() -> MdHtmlOptions []
    MdHtmlOptions { raw_html: RawPass, url_rule: any_url(), heading_id_prefix: "",
                    heading_ids: false, xhtml: true, code_language_class: true,
                    markdown: mdparse.commonmark_options() }

// render appends a whole document's HTML to a buffer and answers it.
//
// ```novo
// use mdhtml
//
// var page: [u8] = []
// mdhtml.render(page, "# Title\n\nBody.\n", mdhtml.default_options())
// println(str.from_int(list.len(page)))
// ```
pub fn render(var out: [u8], source: Str, options: MdHtmlOptions) -> [u8] []
    let p = mdparse.parser_with(source, options.markdown)
    write_events(out, source, p.events, options)

// render_events appends the HTML for a list of events, read against
// the source of the parser that made them.  For a caller that filtered
// or changed the stream.
//
// ```novo
// use mdparse
// use mdhtml
//
// let p = mdparse.parser("*a*\n")
// var out: [u8] = []
// mdhtml.render_events(out, p, p.events, mdhtml.default_options())
// print(bytes.byte_list_to_str(out))   // <p><em>a</em></p>
// ```
pub fn render_events(var out: [u8], p: mdparse.MdParser, events: [mdparse.MdEvent],
                     options: MdHtmlOptions) -> [u8] []
    write_events(out, p.source, events, options)

// render_tree appends the HTML for one node of a tree and everything
// under it; the document node renders the whole document.
//
// ```novo
// use mdtree
// use mdhtml
//
// let doc = mdtree.build("# T\n\nBody.\n")
// var out: [u8] = []
// mdhtml.render_tree(out, doc, mdtree.root(doc), mdhtml.default_options())
// println(str.from_int(list.len(out)))
// ```
pub fn render_tree(var out: [u8], doc: mdtree.MdDoc, index: Int, options: MdHtmlOptions) -> [u8] []
    write_events(out, doc.source, mdtree.subtree_events(doc, index), options)

// render_str is `render` into a new string.
//
// ```novo
// use mdhtml
//
// print(mdhtml.render_str("*hi*\n", mdhtml.default_options()))   // <p><em>hi</em></p>
// ```
pub fn render_str(source: Str, options: MdHtmlOptions) -> Str []
    var out: [u8] = []
    render(out, source, options)
    bytes.byte_list_to_str(out)

// escape_text appends text with `&`, `<`, `>` and `"` escaped, the
// escape this renderer writes element content with.
//
// ```novo
// use mdhtml
//
// var out: [u8] = []
// mdhtml.escape_text(out, "a<b")
// print(bytes.byte_list_to_str(out))   // a&lt;b
// ```
pub fn escape_text(var out: [u8], text: Str) -> [u8] []
    put(out, escaped(text, false))
    out

// escape_attr appends text with `&`, `<`, `>`, `"` and `'` escaped,
// for an attribute value in either kind of quotes.
//
// ```novo
// use mdhtml
//
// var out: [u8] = []
// mdhtml.escape_attr(out, "a\"b")
// print(bytes.byte_list_to_str(out))   // a&quot;b
// ```
pub fn escape_attr(var out: [u8], text: Str) -> [u8] []
    put(out, escaped(text, true))
    out

// heading_id is the anchor a heading gets: its text lowercased, with
// every run of characters other than ASCII letters, digits and
// non-ASCII characters made one hyphen, and hyphens off both ends, the
// rule GitHub uses; then `prefix` before it.  When `seen` already holds
// that id, `-1`, `-2` and so on are appended until it does not.
//
// ```novo
// use mdhtml
//
// println(mdhtml.heading_id("Hello There", ["hello-there"], ""))   // hello-there-1
// ```
pub fn heading_id(text: Str, seen: [Str], prefix: Str) -> Str []
    var parts: [Str] = []
    var dash = false
    for i in 0..str.len(text)
        let b = str.byte_at_or(text, i, 0)
        if mdscan.is_alnum(b) or b >= 0x80
            if dash and list.len(parts) > 0
                list.push(parts, "-")
            dash = false
            list.push(parts, str.from_byte(mdscan.lower_ascii(b)))
        else
            dash = true
    let base = prefix + str.join(parts, "")
    if not list.contains(seen, base)
        return base
    var n = 1
    for _ in 0..list.len(seen) + 1
        if not list.contains(seen, base + "-" + str.from_int(n))
            break
        n = n + 1
    base + "-" + str.from_int(n)

// to_plain appends a document's text with the markup gone: a block
// ends with a line ending, a code block contributes its code, a link
// its text and an image its alt text.  Raw HTML is left out.
//
// ```novo
// use mdparse
// use mdhtml
//
// var out: [u8] = []
// mdhtml.to_plain(out, "# Title\n\n*Some* `code`.\n", mdparse.default_options())
// print(bytes.byte_list_to_str(out))
// ```
pub fn to_plain(var out: [u8], source: Str, options: mdparse.MdOptions) -> [u8] []
    let p = mdparse.parser_with(source, options)
    var parts: [Str] = []
    for ev in p.events
        match ev
            MdText(r)   =>
                list.push(parts, str.slice(source, r.start, r.end))
            MdCode(r)   =>
                list.push(parts, str.slice(source, r.start, r.end))
            MdChar(c)   =>
                list.push(parts, str.from_char(c))
            MdSoftBreak =>
                list.push(parts, "\n")
            MdHardBreak =>
                list.push(parts, "\n")
            MdEnd(tag)  =>
                if block_end(tag)
                    list.push(parts, "\n")
            _           =>
                pass
    put(out, str.join(parts, ""))
    out

fn block_end(tag: mdparse.MdTag) -> Bool
    match tag
        TagParagraph     => true
        TagHeading(_, _) => true
        TagTableCell     => true
        _                => false

// ── The writer ────────────────────────────────────────────────────────

// Append the bytes of `s`.
fn put(var out: [u8], s: Str)
    list.append(out, bytes.to_byte_list(bytes.from_str(s)))

// `s` with `&`, `<`, `>` and `"` escaped, and `'` too for an attribute.
fn escaped(s: Str, attr: Bool) -> Str
    var parts: [Str] = []
    var run = 0
    let n = str.len(s)
    for i in 0..n
        let b = str.byte_at_or(s, i, 0)
        let rep = entity_for(b, attr)
        if rep != ""
            list.push(parts, str.slice(s, run, i))
            list.push(parts, rep)
            run = i + 1
    if run == 0
        return s
    list.push(parts, str.slice(s, run, n))
    str.join(parts, "")

fn entity_for(b: Int, attr: Bool) -> Str
    if b == '&'
        "&amp;"
    elif b == '<'
        "&lt;"
    elif b == '>'
        "&gt;"
    elif b == '"'
        "&quot;"
    elif b == '\'' and attr
        "&#39;"
    else
        ""

// A destination made safe for an `href`: the characters a URL may hold
// as they are, `&` and `'` as entities, and everything else as `%XX` of
// its UTF-8 bytes, as cmark writes it.
fn escaped_href(s: Str) -> Str
    var parts: [Str] = []
    for i in 0..str.len(s)
        let b = str.byte_at_or(s, i, 0)
        if mdscan.is_alnum(b) or b > 32 and b < 127 and str.contains("-_.+!*(),%#@?=;:/$~", str.from_byte(b))
            list.push(parts, str.from_byte(b))
        elif b == '&'
            list.push(parts, "&amp;")
        elif b == '\''
            list.push(parts, "&#x27;")
        else
            list.push(parts, "%" + hex2(b))
    str.join(parts, "")

fn hex2(b: Int) -> Str
    let digits = "0123456789ABCDEF"
    str.slice(digits, b / 16, b / 16 + 1) + str.slice(digits, b % 16, b % 16 + 1)

// The state of one rendering.
struct Writer
    source: Str
    o: MdHtmlOptions
    events: [mdparse.MdEvent]
    var parts: [Str]
    var at_line_start: Bool
    var tags: [mdparse.MdTag]
    var plain_depth: Int
    var column: Int
    var aligns: [mdparse.MdAlign]
    var body_open: Bool
    var seen: [Str]
    var notes: [Str]

fn w(var wr: Writer, s: Str)
    list.push(wr.parts, s)
    wr.at_line_start = str.ends_with(s, "\n")

// A line ending, unless the output is already at the start of a line.
fn cr(var wr: Writer)
    if not wr.at_line_start
        w(wr, "\n")

fn text(wr: Writer, r: mdparse.MdRange) -> Str
    str.slice(wr.source, r.start, r.end)

fn void_end(wr: Writer) -> Str
    if wr.o.xhtml
        " />"
    else
        ">"

fn write_events(var out: [u8], source: Str, events: [mdparse.MdEvent], o: MdHtmlOptions) -> [u8]
    var wr = Writer { source: source, o: o, events: events, parts: [], at_line_start: true,
                      tags: [], plain_depth: 0, column: 0, aligns: [], body_open: false, seen: [],
                      notes: [] }
    for i in 0..list.len(events)
        write_event(wr, i)
    put(out, str.join(wr.parts, ""))
    out

fn top_tag(wr: Writer, depth: Int) -> ?mdparse.MdTag
    let n = list.len(wr.tags)
    if n - 1 - depth < 0
        return None
    Some(wr.tags[n - 1 - depth])

// Whether the paragraph about to open sits in an item of a tight list,
// where CommonMark writes no `<p>`.
//
// The paragraph's own tag is not on the stack, so its grandparent is
// the second from the top, and a list there means an item between.
fn tight_paragraph(wr: Writer) -> Bool
    match top_tag(wr, 1)
        Some(TagList(_, loose)) => not loose
        _                       => false

// Whether the events are inside inline content, where raw HTML is a tag
// rather than a block.
//
// Emphasis, links and images only ever open inside a paragraph, a
// heading or a table cell, so the innermost block decides.
fn inline_context(wr: Writer) -> Bool
    var inside = false
    for k in 0..list.len(wr.tags)
        let tag = wr.tags[list.len(wr.tags) - 1 - k]
        if inline_block(tag)
            inside = true
            break
        if not inline_span(tag)
            break
    inside

fn inline_block(tag: mdparse.MdTag) -> Bool
    match tag
        TagParagraph     => true
        TagHeading(_, _) => true
        TagTableCell     => true
        _                => false

fn inline_span(tag: mdparse.MdTag) -> Bool
    match tag
        TagEmphasis      => true
        TagStrong        => true
        TagStrikethrough => true
        TagLink(_)       => true
        TagImage(_)      => true
        _                => false

fn prev_is(wr: Writer, i: Int, code: Bool) -> Bool
    if i <= 0
        return false
    match wr.events[i - 1]
        MdCode(_) => code
        MdHtml(_) => not code
        _         => false

fn next_is(wr: Writer, i: Int, code: Bool) -> Bool
    if i + 1 >= list.len(wr.events)
        return false
    match wr.events[i + 1]
        MdCode(_) => code
        MdHtml(_) => not code
        _         => false

fn write_event(var wr: Writer, i: Int)
    match wr.events[i]
        MdStart(tag)       =>
            start_tag(wr, tag, i)
            list.push(wr.tags, tag)
        MdEnd(tag)         =>
            wr.tags = wr.tags[0:list.len(wr.tags) - 1]
            end_tag(wr, tag)
        MdText(r)          =>
            w(wr, escaped(text(wr, r), false))
        MdChar(c)          =>
            w(wr, escaped(str.from_char(c), false))
        MdCode(r)          =>
            write_code(wr, i, r)
        MdHtml(r)          =>
            write_html(wr, i, r)
        MdSoftBreak        =>
            let soft = if wr.plain_depth > 0
                " "
            else
                "\n"
            w(wr, soft)
        MdHardBreak        =>
            let hard = if wr.plain_depth > 0
                " "
            else
                "<br" + void_end(wr) + "\n"
            w(wr, hard)
        MdRule             =>
            cr(wr)
            w(wr, "<hr" + void_end(wr) + "\n")
        MdTaskMarker(done) =>
            let checked = if done
                "checked=\"\" "
            else
                ""
            w(wr, "<input " + checked + "disabled=\"\" type=\"checkbox\">")
        MdFootnoteRef(l)   =>
            let n = note_number(wr, text(wr, l))
            let id = escaped(mdscan.label_key(text(wr, l)), true)
            w(wr, "<sup class=\"footnote-ref\"><a href=\"#fn-" + id + "\" id=\"fnref-" + id + "\">"
                  + str.from_int(n) + "</a></sup>")

fn note_number(var wr: Writer, label: Str) -> Int
    let key = mdscan.label_key(label)
    for k in 0..list.len(wr.notes)
        if wr.notes[k] == key
            return k + 1
    list.push(wr.notes, key)
    list.len(wr.notes)

fn write_code(var wr: Writer, i: Int, r: mdparse.MdRange)
    let raw = text(wr, r)
    let in_block = match top_tag(wr, 0)
        Some(TagCodeBlock(_)) => true
        _                     => false
    if in_block
        w(wr, escaped(raw, false))
        return
    let flat = str.replace_all(str.replace_all(str.replace_all(raw, "\r\n", " "), "\n", " "), "\r", " ")
    if wr.plain_depth > 0
        w(wr, escaped(flat, false))
        return
    if not prev_is(wr, i, true)
        w(wr, "<code>")
    w(wr, escaped(flat, false))
    if not next_is(wr, i, true)
        w(wr, "</code>")

fn write_html(var wr: Writer, i: Int, r: mdparse.MdRange)
    let raw = text(wr, r)
    let inline = inline_context(wr)
    if wr.plain_depth > 0
        w(wr, escaped(raw, false))
        return
    match wr.o.raw_html
        RawDrop =>
            return
        _       =>
            pass
    if not inline and not prev_is(wr, i, false)
        cr(wr)
    match wr.o.raw_html
        RawPass =>
            w(wr, raw)
        _       =>
            w(wr, escaped(raw, false))
    if not inline and not next_is(wr, i, false)
        cr(wr)

// The destination of a link as written into the page: its prefix, then
// the destination with its escapes resolved, checked against the rule.
fn destination(wr: Writer, l: mdparse.MdLink) -> Str
    let raw = text(wr, l.destination)
    let resolved = if l.autolink
        raw
    else
        mdscan.unescape(raw)
    let target = l.prefix + resolved
    let allows = wr.o.url_rule.allows
    if allows(target)
        escaped_href(target)
    else
        escaped(wr.o.url_rule.refused, true)

fn title_attr(wr: Writer, l: mdparse.MdLink) -> Str
    if l.title.end <= l.title.start
        return ""
    " title=\"" + escaped(mdscan.unescape(text(wr, l.title)), false) + "\""

fn start_tag(var wr: Writer, tag: mdparse.MdTag, i: Int)
    if wr.plain_depth > 0
        match tag
            TagImage(_) =>
                wr.plain_depth = wr.plain_depth + 1
            _           =>
                pass
        return
    match tag
        TagParagraph              =>
            if not tight_paragraph(wr)
                cr(wr)
                w(wr, "<p>")
        TagHeading(level, anchor) =>
            cr(wr)
            w(wr, "<h" + str.from_int(level) + heading_attr(wr, anchor, i) + ">")
        TagBlockQuote             =>
            cr(wr)
            w(wr, "<blockquote>\n")
        TagCodeBlock(kind)        =>
            cr(wr)
            w(wr, "<pre><code" + language_attr(wr, kind) + ">")
        TagList(kind, _)          =>
            cr(wr)
            match kind
                ListBullet(_)     =>
                    w(wr, "<ul>\n")
                ListOrdered(n, _) =>
                    let open = if n == 1
                        "<ol>\n"
                    else
                        "<ol start=\"" + str.from_int(n) + "\">\n"
                    w(wr, open)
        TagItem                   =>
            cr(wr)
            w(wr, "<li>")
        TagTable(aligns)          =>
            cr(wr)
            w(wr, "<table>\n")
            wr.aligns = aligns[:]
            wr.body_open = false
        TagTableHead              =>
            w(wr, "<thead>\n<tr>\n")
            wr.column = 0
        TagTableRow               =>
            if not wr.body_open
                w(wr, "<tbody>\n")
                wr.body_open = true
            w(wr, "<tr>\n")
            wr.column = 0
        TagTableCell              =>
            let head = match top_tag(wr, 0)
                Some(TagTableHead) => true
                _                  => false
            let cell = if head
                "<th"
            else
                "<td"
            w(wr, cell + align_attr(wr) + ">")
        TagEmphasis               =>
            w(wr, "<em>")
        TagStrong                 =>
            w(wr, "<strong>")
        TagStrikethrough          =>
            w(wr, "<del>")
        TagLink(l)                =>
            w(wr, "<a href=\"" + destination(wr, l) + "\"" + title_attr(wr, l) + ">")
        TagImage(l)               =>
            w(wr, "<img src=\"" + destination(wr, l) + "\" alt=\"")
            wr.plain_depth = 1
        TagFootnoteDefinition(l)  =>
            cr(wr)
            let n = note_number(wr, text(wr, l))
            w(wr, "<div class=\"footnote-definition\" id=\"fn-"
                  + escaped(mdscan.label_key(text(wr, l)), true)
                  + "\"><sup class=\"footnote-definition-label\">" + str.from_int(n) + "</sup>\n")

fn end_tag(var wr: Writer, tag: mdparse.MdTag)
    if wr.plain_depth > 0
        match tag
            TagImage(l) =>
                wr.plain_depth = wr.plain_depth - 1
                if wr.plain_depth == 0
                    w(wr, "\"" + title_attr(wr, l) + void_end(wr))
            _           =>
                pass
        return
    match tag
        TagParagraph             =>
            if not tight_paragraph(wr)
                w(wr, "</p>\n")
        TagHeading(level, _)     =>
            w(wr, "</h" + str.from_int(level) + ">\n")
        TagBlockQuote            =>
            cr(wr)
            w(wr, "</blockquote>\n")
        TagCodeBlock(_)          =>
            w(wr, "</code></pre>\n")
        TagList(kind, _)         =>
            match kind
                ListBullet(_)     =>
                    w(wr, "</ul>\n")
                ListOrdered(_, _) =>
                    w(wr, "</ol>\n")
        TagItem                  =>
            w(wr, "</li>\n")
        TagTable(_)              =>
            if wr.body_open
                w(wr, "</tbody>\n")
            w(wr, "</table>\n")
        TagTableHead             =>
            w(wr, "</tr>\n</thead>\n")
        TagTableRow              =>
            w(wr, "</tr>\n")
        TagTableCell             =>
            let head = match top_tag(wr, 0)
                Some(TagTableHead) => true
                _                  => false
            let close = if head
                "</th>\n"
            else
                "</td>\n"
            w(wr, close)
            wr.column = wr.column + 1
        TagEmphasis              =>
            w(wr, "</em>")
        TagStrong                =>
            w(wr, "</strong>")
        TagStrikethrough         =>
            w(wr, "</del>")
        TagLink(_)               =>
            w(wr, "</a>")
        TagImage(_)              =>
            pass
        TagFootnoteDefinition(_) =>
            cr(wr)
            w(wr, "</div>\n")

fn language_attr(wr: Writer, kind: mdparse.MdCodeKind) -> Str
    if not wr.o.code_language_class
        return ""
    match kind
        CodeFenced(info) =>
            let words = mdscan.unescape(text(wr, info))
            var e = 0
            for k in 0..str.len(words)
                let b = str.byte_at_or(words, k, 0)
                if b == ' ' or b == '\t'
                    break
                e = k + 1
            if e == 0
                return ""
            " class=\"language-" + escaped(str.slice(words, 0, e), true) + "\""
        CodeIndented     =>
            ""

fn align_attr(wr: Writer) -> Str
    if wr.column >= list.len(wr.aligns)
        return ""
    match wr.aligns[wr.column]
        AlignLeft   => " align=\"left\""
        AlignCentre => " align=\"center\""
        AlignRight  => " align=\"right\""
        AlignNone   => ""

// The `id` of a heading whose start event is `i`: the document's anchor
// when it gave one, and one made from the heading's text otherwise.
fn heading_attr(var wr: Writer, anchor: mdparse.MdRange, i: Int) -> Str
    if not wr.o.heading_ids
        return ""
    var id = ""
    if anchor.end > anchor.start
        id = text(wr, anchor)
    else
        id = heading_id(heading_text(wr, i), wr.seen, wr.o.heading_id_prefix)
    list.push(wr.seen, id)
    " id=\"" + escaped(id, true) + "\""

// The text of the heading whose start event is `i`.
fn heading_text(wr: Writer, i: Int) -> Str
    var parts: [Str] = []
    var depth = 0
    for k in i + 1..list.len(wr.events)
        match wr.events[k]
            MdStart(_)  =>
                depth = depth + 1
            MdEnd(_)    =>
                if depth == 0
                    break
                depth = depth - 1
            MdText(r)   =>
                list.push(parts, text(wr, r))
            MdCode(r)   =>
                list.push(parts, text(wr, r))
            MdChar(c)   =>
                list.push(parts, str.from_char(c))
            MdSoftBreak =>
                list.push(parts, " ")
            _           =>
                pass
    str.join(parts, "")
